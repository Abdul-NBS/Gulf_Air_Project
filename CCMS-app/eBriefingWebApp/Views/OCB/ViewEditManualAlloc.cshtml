@model List<eBriefingWebApp.ViewModels.DailyTimeRecordVM>
@{
    ViewBag.Title = "Manual Allocations";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("ViewEditManualAlloc", "OCB", FormMethod.Post))
{

    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                            <br />
                          </div>
                        <!-- <div class="col-md-4 justify-content-end">
            <div class="input-group mb-3">
                <input name="Flight_Date" id="Flight_Date" value="@ViewBag.FlightDate" class="form-control" type="date" />
                <div class="input-group-append">
                    <button type="submit" class="btn btn-dark btn-outline-secondary">Get Data</button>
                </div>
            </div>
        </div>-->
    </div>
                    </div>
                <div>
                    <table id="TableData" class="table table-striped table-hover my-0">
                        <thead>
                            <tr>
                                <th class="text-center fw-bold">Duty</th>
                                <th class="text-center fw-bold">Flight Number</th>
                                <th class="text-center fw-bold">Block Date</th>
                                <th class="text-center fw-bold">Check In</th>
                                <th class="text-center fw-bold">Route</th>
                                <th class="text-center fw-bold">Room</th>
                                <th class="text-center fw-bold">Status</th>
                                <th class="text-center fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                if (Model[i].Status != "Exclude")
                                {
                                    <tr data-index="@i">
                                        <td style="width:150px;" class="text-center">
                                            @Html.TextBoxFor(m => m[i].Duty, new { @class = "form-control", @Value = "ops", @Style = "text-align:center", id = "Model[" + i + "].Duty" })
                                            @Html.HiddenFor(m => m[i].FlightId, new { id = "Model[" + i + "].FlightId" })
                                        </td>
                                        <td class="text-center">@Model[i].FlightNumber</td>
                                        <td class="text-center">@Model[i].FlightDate.ToString("dd MMM yyyy")</td>
                                        <td class="text-center">@Model[i].CheckInTime.AddMinutes(-100).AddHours(3).ToString("HH:mm")</td>
                                        <td class="text-center">@Model[i].Route</td>
                                        <td style="width: 150px;" class="text-center">
                                            @Html.TextBoxFor(m => m[i].Room, new { @class = "form-control", @Style = "text-align:center", id = "Model[" + i + "].Room" })
                                        </td>
                                        <td style="width: 150px;" class="text-center">
                                            @Html.DropDownListFor(m => m[i].Status, new SelectList(ViewBag.GetStatus, "Value", "Text", Model[i].Status), "Select Status", new { id = "Model[" + i + "].Status", @class = "form-control" })
                                        </td>
                                        <td style="width: 150px;" class="text-center">
                                            <button type="button" class="btn btn-dark btn-sm save-row">Save</button>
                                            <button type="button" class="btn btn-danger btn-sm delete-row">Delete</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    <button id="btnSaveAll" type="button" class="btn btn-info">Save All</button>
                    <a href="@Url.Action("DailyTimeRecord", "OCB", new { FlightDate = ViewBag.FlightDate })" class="btn btn-dark btn-outline-secondary">Back</a>
                </div>
            </div>
        </div>
    </div>


    if (TempData["Status"] != null)
    {
        if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }


}


<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>
<script>

         $(document).ready(function() {
        $('.save-row').click(function(e) {
            e.preventDefault();
            var $row = $(this).closest('tr');
            var index = $row.data('index');

            var data = {
                Duty: $row.find('[id="Model[' + index + '].Duty"]').val(),
                FlightId: $row.find('[id="Model[' + index + '].FlightId"]').val(),
                FlightNumber: $row.find('td:eq(1)').text().trim(),
                FlightDate: $row.find('td:eq(2)').text().trim(),
                CheckInTime: $row.find('td:eq(3)').text().trim(),
                Route: $row.find('td:eq(4)').text().trim(),
                Room: $row.find('[id="Model[' + index + '].Room"]').val(),
                Status: $row.find('[id="Model[' + index + '].Status"]').val()
            };

            console.log(data); // Debugging: Check the data object

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveRowModified", "OCB")',
                data: data,
                success: function(response) {
                    toastr.success('Record Saved.');
                },
                error: function() {
                    toastr.error('Error Saving Record.');
                }
            });
        });
         $('.delete-row').click(function(e) {
     e.preventDefault();
     var $row = $(this).closest('tr');
     var index = $row.data('index');

     var data = {
         Duty: $row.find('[id="Model[' + index + '].Duty"]').val(),
         FlightId: $row.find('[id="Model[' + index + '].FlightId"]').val(),
         FlightNumber: $row.find('td:eq(1)').text().trim(),
         FlightDate: $row.find('td:eq(2)').text().trim(),
         CheckInTime: $row.find('td:eq(3)').text().trim(),
         Route: $row.find('td:eq(4)').text().trim(),
         Room: $row.find('[id="Model[' + index + '].Room"]').val(),
         Status: $row.find('[id="Model[' + index + '].Status"]').val()
     };

     console.log(data); // Debugging: Check the data object

     $.ajax({
         type: 'POST',
         url: '@Url.Action("DeleteRowModified", "OCB")',
         data: data,
         success: function(response) {
             toastr.success('Record Deleted.');
         },
         error: function() {
             toastr.error('Error deleting Record.');
         }
     });
 });

        $('#btnSaveAll').click(function(e) {
            e.preventDefault();
            var allData = [];
            $('#TableData tbody tr').each(function() {
                var $row = $(this);
                var index = $row.data('index');

                if (index !== undefined) {
                    var rowData = {
                        Duty: $row.find('[id="Model[' + index + '].Duty"]').val(),
                        FlightId: $row.find('[id="Model[' + index + '].FlightId"]').val(),
                        FlightNumber: $row.find('td:eq(1)').text().trim(),
                        FlightDate: $row.find('td:eq(2)').text().trim(),
                        CheckInTime: $row.find('td:eq(3)').text().trim(),
                        Route: $row.find('td:eq(4)').text().trim(),
                        Room: $row.find('[id="Model[' + index + '].Room"]').val(),
                        Status: $row.find('[id="Model[' + index + '].Status"]').val()
                    };

                    allData.push(rowData);
                }
            });

            console.log(allData); // Debugging: Check the allData object

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveAllModified", "OCB")',
                data: JSON.stringify(allData),
                contentType: 'application/json; charset=utf-8',
                success: function(response) {
                    toastr.success('All Records Saved.');
                },
                error: function() {
                    toastr.error('Error Saving All Records.');
                }
            });
        });
    });

    $('#TableData').dataTable({
        dom: 'Bfrtip',
        bPaginate: false,
        columnDefs: [
            {
                targets: [3],
                orderDataType: 'dom-text',
                type: 'string',
                orderSequence: ['desc', 'asc'],
                orderData: function (data) {
                    var time = moment(data[4], 'HH:mm');
                    return time.valueOf();
                }
            },
        ],
        buttons: [
            {
                extend: 'excel',
                title: 'AllocationScreen',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4, 5]
                }
            }
        ]
    });


</script>

