@model List<eBriefingWebApp.vwRecency>
@{
    ViewBag.Title = "Crew Recency Report";
    Layout = "~/Views/Shared/_layout.cshtml";
}

@using (Html.BeginForm("StaffRecencyReport", "OCB", FormMethod.Post))
{
<div class="row">
    <div class="col-md-12">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title mb-0">@ViewBag.Title</h5>
                    </div>

                </div>
            </div>
            <table id="TableData" class="table table-striped table-hover my-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold">#</th>

                        <th class="text-center fw-bold">Staff Number</th>
                        <th class="text-center fw-bold">Full Name</th>
                        <th class="text-center fw-bold">Flight Date</th>
                        <th class="text-center fw-bold">Flight Family</th>
                        <th class="text-center fw-bold">Position</th>
                        <th class="text-center fw-bold">Expiry Date</th>

                    </tr>
                </thead>
                <tbody>
                    @{
                        int count = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-left">@count</td>

                            <td class="text-center">@item.StaffNumber</td>
                            <td class="text-center">@item.FullName</td>
                            <td class="text-center">@item.Block_Date</td>
                            <th class="text-center">@item.Family</th>
                            <th class="text-center">@item.PosCode</th>
                            <td class="text-center">@item.Expiry_Date</td>

                        </tr>
                        count++;
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
    
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'CrewPosHistory',
                exportOptions: {
                    columns: [0, 1, 2, 3]
                }
            }
        ]
    });
</script>

