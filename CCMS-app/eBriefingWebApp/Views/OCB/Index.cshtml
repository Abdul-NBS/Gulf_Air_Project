@model List<eBriefingWebApp.OCB_Blocks>
@{
    ViewBag.Title = "Cabin Crew Position";
    Layout = "~/Views/Shared/_layout.cshtml";
}


@using (Html.BeginForm("Index", "OCB", FormMethod.Post))

{
    @*<input type="hidden" id="currentPage" value="" />*@

    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />


    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                            <br />
                            <a href="@Url.Action("UpdateSettings", "OCB")" class="btn btn-dark btn-outline-secondary">Settings</a>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3">
                                <input name="Block_Date" id="Block_Date" value="@Convert.ToDateTime(TempData["Block_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                <div class="input-group-append">
                                    <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Delete</th>
                            <th class="text-center fw-bold">Flight Number</th>
                            <th class="text-center fw-bold">Block Number</th>
                            <th class="text-center fw-bold">Block Date</th>
                            <th class="text-center fw-bold">Start Time</th>
                            <th class="text-center fw-bold">Reporting Time</th>
                            <th class="text-center fw-bold">Length</th>
                            <th class="text-center fw-bold">Block End Date</th>
                            <th class="text-center fw-bold">Eqp</th>
                            <th class="text-center fw-bold">Assigned/Total Crew </th>
                            <th class="text-center fw-bold">Unassigned</th>
                            <th class="text-center fw-bold">Crew Pos.</th>
                            <th class="text-center fw-bold">Details</th>

                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int currentPage = Convert.ToInt32(Request.Form["currentPage"]);
                        }

                        @foreach (var item in Model.Where(a => a.OCB_CrewPos.Count > 0))
                        {
                            <tr>
                                <td class="text-center">
                                    @{
                                        // eBriefingWebApp.CSMEntities dbDelete = new eBriefingWebApp.CSMEntities();
                                        eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();
                                        var deleteTimeDiffSetting = db.Settings.Where(a => a.Title == "BlockDeleteIntervel").FirstOrDefault();
                                        int deleteTimeDifference = 180;
                                        if (deleteTimeDiffSetting != null)
                                        {
                                            deleteTimeDifference = Convert.ToInt16(deleteTimeDiffSetting.Value);
                                        }
                                        var reportingTime = item.Start_Time.Value.AddMinutes(-100).AddHours(3);

                                        if (reportingTime.Subtract(DateTime.UtcNow.AddHours(3)).TotalMinutes > deleteTimeDifference)
                                        {

                                            <a href="#" class="delete-block" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-block-id="@item.Id" data-block-date="@Convert.ToDateTime(TempData["Block_Date"]).ToString("yyyy-MM-dd")" title="Delete Block">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2 text-danger">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </a>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        var _flightNumber = item.OCB_Flights.FirstOrDefault(a => a.Orig == "BAH");

                                        if (_flightNumber != null)
                                        {
                                            @Html.DisplayFor(modelItem => _flightNumber.Flt_No)
                                        }

                                        var activeCrew = item.OCB_CrewPos.Where(a => a.is_deleted == false).ToList();
                                        var assignedCrew = item.OCB_CrewPos.Where(a => a.PosId != null && a.is_deleted == false).ToList();
                                        var crewCount = activeCrew.Count;
                                        var assignedCrewCnt = assignedCrew.Count;
                                        var unassignedCrewCount = crewCount - assignedCrewCnt;
                                        if (unassignedCrewCount > 0)
                                        {
                                            var unassignedCrew = item.OCB_CrewPos.Where(a => a.PosId == null && a.is_deleted == false).ToList();

                                            // Get distinct categories
                                            var categories = unassignedCrew.Select(c => c.Category).Distinct().ToList();

                                            // Dictionary to store the counts for each category
                                            Dictionary<string, int> categoryCounts = new Dictionary<string, int>();

                                            // Iterate through each category
                                            foreach (var category in categories)
                                            {
                                                // Count the crew members in the current category
                                                int count = unassignedCrew.Count(c => c.Category == category);
                                                // Add the category and its count to the dictionary
                                                categoryCounts.Add(category, count);
                                            }

                                            // Now you have the counts in the categoryCounts dictionary
                                            // You can use this dictionary as needed, for example:
                                            foreach (var kvp in categoryCounts)
                                            {
                                                string category = kvp.Key;
                                                int count = kvp.Value;

                                            }
                                        }

                                    }
                                </td>

                                <td class="text-center">@item.Block_No</td>
                                <td class="text-center">@item.Block_Date.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.Start_Time.Value.ToString("HH:mm")</td>
                                <td class="text-center">@item.Start_Time.Value.AddMinutes(-100).AddHours(3).ToString("HH:mm")</td>
                                <td class="text-center">@item.Days_No</td>
                                <td class="text-center">@item.End_Date.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.Eqp</td>
                                <td class="text-center">@assignedCrewCnt / @crewCount</td>

                                <td class="text-center">
                                    @{
                                        if (unassignedCrewCount > 0)
                                        {
                                            var unassignedCrew = item.OCB_CrewPos.Where(a => a.PosId == null && a.is_deleted == false).ToList();
                                            var categories = unassignedCrew.Select(c => c.Category).Distinct().ToList();
                                            Dictionary<string, int> categoryCounts = new Dictionary<string, int>();

                                            foreach (var category in categories)
                                            {
                                                int count = unassignedCrew.Count(c => c.Category == category);
                                                categoryCounts.Add(category, count);
                                            }

                                            // Display the categories and their counts
                                            string displayString = string.Join(", ", categoryCounts.Select(kvp => kvp.Key + ":" + kvp.Value));
                                            @Html.Raw(displayString)
                                        }
                                        else
                                        {
                                            @:None
                                        }
                                    }
                                </td>

                                <td class="text-center">
                                    @{
                                        var completed = @item.OCB_CrewPos.All(a => a.PosId != null && a.is_deleted == false);
                                        var notCompleted = @item.OCB_CrewPos.All(a => a.PosId == null && a.is_deleted == false);
                                        var updated = @item.OCB_CrewPos.Any(a => a.PosId == null && a.is_deleted == false);
                                        var AllMissing = @item.OCB_CrewPos.All(a => a.is_deleted == true);
                                        bool updateFlight = false;

                                        var eqp = item.Eqp;
                                        var query = from crewPos in db.OCB_CrewPos
                                                    where crewPos.BlockId == item.Id &&
                                                          db.OCB_AC_Pos.Any(acPos => acPos.Id == crewPos.PosId && acPos.EQP == eqp)
                                                    select crewPos.PosId;

                                    }
                                    @if (query.Count() > 0)
                                    {
                                        //completed = true;
                                    }
                                    else
                                    {
                                        completed = false;
                                        updateFlight = true;

                                    }

                                    @if (completed)
                                    {
                                        <label style="color:green;" data-bs-toggle="tooltip" data-bs-placement="top" title="Completed">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check align-middle me-2">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Completed" />
                                    }
                                    else if (notCompleted)
                                    {
                                        <label style="color:red;" data-bs-toggle="tooltip" data-bs-placement="top" title="Not Completed">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Not Completed" />
                                    }
                                    else if (updated)
                                    {
                                        <label style="color:orange;" data-bs-toggle="tooltip" data-bs-placement="top" title="Updated">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-alert-circle align-middle me-2">
                                                <path d="M12 2C6.48 2 2 6.48 2 12c0 5.52 4.48 10 10 10s10-4.48 10-10c0-5.52-4.48-10-10-10zm0 14h-.01"></path>
                                                <circle cx="12" cy="16" r="1"></circle>
                                                <path d="M12 8V12"></path>
                                            </svg>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Updated" />
                                    }
                                    else if (AllMissing)
                                    {
                                        <label style="color:gray;" data-bs-toggle="tooltip" data-bs-placement="top" title="Missing Crew">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Missing Crew" />
                                    }
                                    else if (updateFlight)
                                    {
                                        <label style="color:orange;" data-bs-toggle="tooltip" data-bs-placement="top" title="Flight Updated">
                                            <b>A/C</b>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Flight Updated" />
                                    }
                                    else
                                    {
                                        <label style="color:green;" data-bs-toggle="tooltip" data-bs-placement="top" title="Completed">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check align-middle me-2">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </label>

                                        <input type="hidden" id="tooltipFilterValue" value="Completed" />
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("CabinCrewPos", "OCB", new { Id = item.Id, Block_Date = Convert.ToDateTime(TempData["Block_Date"]).ToString("yyyy-MM-dd") })" title="View Block Details">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                    </a>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmDeleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this block?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" id="deleteConfirmButton">Delete</button>
                </div>
            </div>
        </div>
    </div>
}


<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>

<script>
    var table; // for more big scope
    $(function () {
        var currentPageInput = $('#currentPage');
         table = $('#TableData').DataTable({
            dom: 'Bfrtip',
            order: [[3, 'desc'], [4, 'asc']],
            columnDefs: [
                {
                    type: 'time-date-sort',
                    targets: [4],
                }
            ],
            buttons: [
                {
                    extend: 'excel',
                    title: 'CabinCrewPosition',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5, 6, 7, 8]
                    }
                }
            ],
            initComplete: function () {
                var api = this.api();
                currentPageInput.val(api.page.info().page + 1);
            }
        });

    });

    $('#confirmDeleteModal').on('show.bs.modal', function (e) {
        var button = $(e.relatedTarget);
        var blockId = button.data('block-id');
        var blockDate = button.data('block-date');
        var modal = $(this);
        modal.find('#deleteConfirmButton').attr('data-block-id', blockId);
        modal.find('#deleteConfirmButton').attr('data-block-date', blockDate);
    });

    $('#deleteConfirmButton').click(function () {
        var blockId = $(this).data('block-id');
        var blockDate = $(this).data('block-date');
        $('#confirmDeleteModal').modal('hide');
        $('#loadingModal').modal('show');
        $.ajax({
            type: "POST",
            url: "/OCB/DeleteBlock",
            data: { BlockId: blockId, Block_Date: blockDate },
            success: function (response) {
                $('#loadingModal').modal('hide');
                if (response.success) {
                    table.row($('a[data-block-id="' + blockId + '"]').parents('tr')).remove().draw();
                   
                   // alert("Block deleted successfully.");
                   // window.location.reload();
                    $('#successDeleteModal').modal('show');

                } else {
                    alert("Error deleting block: " + response.message);
                }
            },
            error: function () {
                alert("An error occurred while deleting the block.");
            }
        });
    });

    
</script>

<div class="modal fade" id="successDeleteModal" tabindex="-1" role="dialog" aria-labelledby="successDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="successDeleteModalLabel">Success</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Block deleted successfully.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="loadingModal" tabindex="-1" role="dialog" aria-labelledby="loadingModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-body text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Deleting block...</p>
            </div>
        </div>
    </div>
</div>


