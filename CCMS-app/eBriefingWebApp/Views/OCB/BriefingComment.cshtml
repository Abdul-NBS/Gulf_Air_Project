@model List<eBriefingWebApp.OCB_Comments>
@{
    ViewBag.Title = "Briefing Comment";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("BriefingComment", "OCB", FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-6 justify-content-end">
                            <div class="input-group mb-13">

                                <input name="DateFrom" id="DateFrom" class="form-control" type="date" placeholder="Date From" required />
                                <input name="DateTo" id="DateTo" class="form-control" type="date" placeholder="Date To" required />
                                <input name="StaffNumber" id="StaffNumber" class="form-control" type="text" placeholder="Staff Number" required />
                                <div class="input-group-append">
                                    <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Block Number</th>
                            <th class="text-center fw-bold">Block Date</th>
                            <th class="text-center fw-bold">Staff Number</th>
                            <th class="text-center fw-bold">Full Name</th>
                            <th class="text-center fw-bold">Comment</th>
                            <th class="text-center fw-bold">Time</th>
                            <th class="text-center fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@item.OCB_CrewPos.OCB_Blocks.Block_No</td>
                                <td class="text-center">@item.OCB_CrewPos.OCB_Blocks.Block_Date.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.OCB_CrewPos.StaffNumber</td>
                                <td class="text-center">@item.OCB_CrewPos.CrewDetail.FullName</td>
                                <td class="text-center">@item.Comment</td>
                                <td class="text-center">@item.Time</td>
                                <td class="text-center">
                                    <a href="@Url.Action("DeleteOCBComment", "OCB", new { Id = item.Id})" title="Delete Comment">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2 align-middle me-2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    if (TempData["Status"] != null)
    {

        if (TempData["Status"].ToString() == "Deleted")
        {
            <script>
                toastr.success('Record Deleted.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Not Found")
        {
            <script>
                toastr.warning('Record Not Found.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Deleting Record.');
            </script>
        }
    }
}


<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'CabinCrewPosition',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4]
                }
            }
        ]
    });
</script>

