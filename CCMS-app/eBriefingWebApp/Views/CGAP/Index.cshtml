@model eBriefingWebApp.Crew_Grooming
@{
    ViewBag.Title = "Get Grooming Data";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("IndexPost", "CGAP", FormMethod.Post))
{
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Crew Grooming Detail</h5>
                </div>

                @if (TempData["Status"] != null)
                {
                    if (TempData["Status"] == "NoCrew")
                    {
                        <label class="fw-bold text-danger ms-3 mt-3">The entered id does not belong to a crew. Please re-enter correct crewId </label>
                    }
                }
                <div class="card-body">
                    <div class="input-group">
                        <input name="StaffNumber" id="StaffNumber" class="form-control" type="number" />
                        <div class="input-group-append">
                            <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
}
<div class="card-header">
    <h5 class="card-title mb-0">Upcoming Reviews</h5>
</div>

@{
    eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();
     var currentDate = DateTime.Now;
      var thirtyDaysFromNow = currentDate.AddDays(30);

     var result = db.CrewWeightDetailLists.Where(c => c.Date_To >= currentDate && c.Date_To <= thirtyDaysFromNow).OrderBy(a => a.Date_To).ToList();

    //var currentDate = DateTime.Now;
   // var fifteenDaysBefore = currentDate.AddDays(-90);

   // var result = db.CrewWeightDetailLists.Where(c => c.Date_To >= fifteenDaysBefore && c.Date_To <= currentDate).OrderBy(a => a.Date_To).ToList();
    int i = 1;
    <table id="TableData" class="table table-striped table-hover my-0">
        <thead>
            <tr>
                <th class="text-center fw-bold">#</th>
                <th class="text-center fw-bold">Staff Number</th>
                <th class="text-center fw-bold">Staff Name</th>
                <th class="text-center fw-bold">Past Review Date</th>
                <th class="text-center fw-bold">Upcoming Review Date</th>

            </tr>
        </thead>
        <tbody>
             
            @foreach (var item in result)
            {

                <tr>
                    <td class="text-center">@i</td>
                    <td class="text-center">@item.Employee_Number</td>
                    <td class="text-center">@item.Employee_Name</td>
                    <td class="text-center">@item.Date_Weight.Value.ToString("dd MMM yyyy")</td>
                    <td class="text-center">@item.Date_To.Value.ToString("dd MMM yyyy")</td>

                </tr>
                i++;
            }
        </tbody>
    </table>

}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'Appraisal Data Sheet',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4]
                }
            }
        ],
        order: [[0, 'asc']]
    });
</script>


