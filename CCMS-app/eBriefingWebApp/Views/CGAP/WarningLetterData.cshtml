@model List<eBriefingWebApp.Crew_WarningLetter>
@{
    ViewBag.Title = "Crew Warning Data";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("DailyTimeRecord", "OCB", FormMethod.Post))
{
    @Html.Hidden("LoggedUser", (string)TempData["LoggedUser"])
    @Html.Hidden("CrewUser", (string)TempData["CrewUser"])
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            
                           
                            <button id="addNewWarning" class="btn btn-dark m-0" type="button">Add New Warning</button>

                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3">
                              
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <table id="TableData" class="table table-striped table-hover my-0">
                        <thead>
                            <tr>
                                <th class="text-center fw-bold">Staff Number</th>
                                <th class="text-center fw-bold">Staff Name</th>
                                <th class="text-center fw-bold">Date</th>
                                <th class="text-center fw-bold">Subject</th>
                                <th class="text-center fw-bold">Updated By</th>
                                <th class="text-center fw-bold">View</th>
                                <th class="text-center fw-bold">Delete</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {


                                <tr>

                                    <td class="text-center">@item.StaffNumber</td>
                                    <td class="text-center">@item.StaffName</td>
                                    <td class="text-center">@item.WarnEntryDate.Value.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">@item.WarnEntrySubject</td>
                                    <td class="text-center">@item.Reported_By</td>

                                    <td class="text-center">


                                        <a href="@Url.Action("ViewWarnData", "CGAP", new { Id = (item.Id) })" title="View Commendation Data">
                                            <!--<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>-->
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"  
                                                 class="feather feather-eye">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("DeleteWarnData", "CGAP", new { Id = (item.Id) })" title="Delete Appreciation data">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2">
                                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                                <line x1="6" y1="6" x2="18" y2="18"></line>
                                            </svg>

                                        </a>
                                    </td>
                                </tr>

                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>


    if (TempData["Status"] != null)
    {
        if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }


}

<div class="modal fade" id="warningModal" tabindex="-1" aria-labelledby="warningModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commendationModalLabel">Add New Commendation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="entryDate" class="form-label">Entry Date</label>
                    <input type="date" class="form-control" id="entryDate" required />
                </div>
                <div class="mb-3">
                    <label for="letterType" class="form-label">Letter Type</label>
                    <select class="form-select" id="letterType" required>
                        <option value="">Select Letter Type</option>
                        <option value="File Reference">File Reference</option>
                        <option value="Written">Written</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="subject" class="form-label">Subject</label>
                    <input type="text" class="form-control" id="subject" required />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" rows="10" required></textarea>
                </div>
                <div class="mb-3">
                    <label for="attachment" class="form-label">Attachment</label>
                    <input type="file" class="form-control" id="attachment" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveWarning">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>
<script>
    $(document).ready(function () {
        $("#addNewWarning").click(function () {
            $("#warningModal").modal('show');
        });

        $("#saveWarning").click(function () {
            var entryDate = $("#entryDate").val();
            var subject = $("#subject").val();
            var description = $("#description").val();
            var staffNumber = $("#CrewUser").val();
            var loggedUser = $("#LoggedUser").val();
            var attachment = $("#attachment")[0].files[0];
            var letterType = $("#letterType").val();// Get the file

            var formData = new FormData(); // Create FormData object
            formData.append("entryDate", entryDate);
            formData.append("subject", subject);
            formData.append("description", description);
            formData.append("staffNumber", staffNumber);
            formData.append("loggedUser", loggedUser);
            formData.append("attachment", attachment);
            formData.append("letterType", letterType);
            // Append the file

            $.ajax({
                url: '/CGAP/AddCrewWarning',
                type: 'POST',
                data: formData,
                contentType: false, // Required for file uploads
                processData: false, // Required for file uploads
                success: function (response) {
                    if (response.success) {
                        toastr.success('Commendation saved successfully.');
                        $("#warningModal").modal('hide');
                        location.reload();
                    } else {
                        toastr.error('Error saving appreciation.');
                    }
                },
                error: function () {
                    toastr.error('An error occurred while saving.');
                }
            });
        });

        $('#TableData').dataTable({
            dom: 'Bfrtip',
            bPaginate: false,
            order: [[2, 'desc']],
            buttons: [
                {
                    extend: 'excel',
                    title: 'Commendation Letters',
                    exportOptions: {
                        columns: [0, 1, 2, 3]
                    }
                }
            ]
        });
    }); // Make sure this closing bracket is there.
</script>

