@model List<eBriefingWebApp.CrewDocumentCategory>
@{
    ViewBag.Title = "Crew Document Categories";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("DailyTimeRecord", "OCB", FormMethod.Post))
{
    @Html.Hidden("LoggedUser", (string)TempData["LoggedUser"])
    @Html.Hidden("CrewUser", (string)TempData["CrewUser"])
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <button id="addNewCategory" class="btn btn-dark m-0" type="button">Add New Category</button>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3">
                            </div>
                        </div>
                    </div>
                </div>
                <div>
                    <table id="TableData" class="table table-striped table-hover my-0">
                        <thead>
                            <tr>
                                <th class="text-center fw-bold">#</th>
                                <th class="text-center fw-bold">Crew Document Category</th>
                                <th class="text-center fw-bold">Category Description</th>
                                <th class="text-center fw-bold">Activate / Inactivate</th>
                                <th class="text-center fw-bold">Status</th>
                                <th class="text-center fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center">@i</td>
                                        <td class="text-center">@item.CategoryName</td>
                                        <td class="text-center">@item.CategoryDescription</td>
                                        <td class="text-center">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input changeStatus" type="checkbox"
                                                       data-id="@item.Id"
                                                       @Html.Raw((item.IsActive ?? false) ? "checked" : "")>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @Html.Raw((item.IsActive ?? false) ? "<span class='badge bg-success'>Active</span>" : "<span class='badge bg-danger'>Inactive</span>")
                                        </td>
                                        <td class="text-center">
                                            <a href="@Url.Action("DeleteCategory", "CrewDocument", new { Id = (item.Id) })" title="Delete Category">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2">
                                                    <line x1="18" y1="6" x2="6" y2="18"></line>
                                                    <line x1="6" y1="6" x2="18" y2="18"></line>
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    if (TempData["Status"] != null)
    {
        if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }
}

<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <input type="text" class="form-control" id="category" required />
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" rows="3" required></textarea>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveCategory">Save</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>
<script>
    $(document).ready(function () {
        $("#addNewCategory").click(function () {
            $("#categoryModal").modal('show');
        });

        $("#saveCategory").click(function () {

            var category = $("#category").val();
            var description = $("#description").val();

            var formData = new FormData(); // Create FormData object

            formData.append("category", category);
            formData.append("description", description);

            $.ajax({
                url: '/CrewDocument/AddDocumentCategory',
                type: 'POST',
                data: formData,
                contentType: false, // Required for file uploads
                processData: false, // Required for file uploads
                success: function (response) {
                    if (response.success) {
                        toastr.success('Category saved successfully.');
                        $("#categoryModal").modal('hide');
                        location.reload();
                    } else {
                        toastr.error('Error saving category.');
                    }
                },
                error: function () {
                    toastr.error('An error occurred while saving.');
                }
            });
        });

        $('#TableData').dataTable({
            dom: 'Bfrtip',
            bPaginate: false,
            order: [[0, 'asc']], // Order by Category Name
            buttons: [
                {
                    extend: 'excel',
                    title: 'Crew Document Categories',
                    exportOptions: {
                        columns: [0, 1, 2, 4] // Include the Status column in export
                    }
                }
            ]
        });

        // Handle change status toggle
        $(document).on('change', '.changeStatus', function () {
            var categoryId = $(this).data('id');
            var isActive = $(this).prop('checked');
            var $row = $(this).closest('tr');
            var $statusCell = $row.find('td:eq(4)'); // Target the Status column

            $.ajax({
                url: '@Url.Action("ChangeCategoryStatus", "CrewDocument")',
                type: 'POST',
                data: { id: categoryId, isActive: isActive },
                success: function (response) {
                    if (response.success) {
                        toastr.success('Category status updated successfully.');
                        if (isActive) {
                            $statusCell.html("<span class='badge bg-success'>Active</span>");
                        } else {
                            $statusCell.html("<span class='badge bg-danger'>Inactive</span>");
                        }
                    } else {
                        toastr.error('Error updating category status.');
                        // Revert the toggle if the update failed
                        $(this).prop('checked', !isActive);
                    }
                },
                error: function () {
                    toastr.error('An error occurred while updating category status.');
                    // Revert the toggle if the update failed
                    $(this).prop('checked', !isActive);
                }
            });
        });
    });
</script>