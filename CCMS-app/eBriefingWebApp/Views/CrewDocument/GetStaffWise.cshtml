@model List<eBriefingWebApp.PilotCrewDocument>
@{
    ViewBag.Title = "Crew Wise Documents";
    Layout = "~/Views/Shared/_layout.cshtml";
    string staffNumberValue = Request.Form["StaffNumber"]; // Get the posted StaffNumber
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>
@if (TempData["InvalidUser"] != null && (bool)TempData["InvalidUser"] == true)
{
    <div class="alert alert-danger">
        Invalid Staff Number entered. Please try again.
    </div>
}
else if (TempData["Status"] != null)
{
    if (TempData["Status"].ToString() == "NoCrew")
    {
        staffNumberValue = "";
        <div class="alert alert-warning">
            No crew found with the entered Staff Number.
        </div>
    }
    else if (TempData["Status"].ToString() == "Error")
    {
        <div class="alert alert-danger">
            An error occurred while loading the documents. Please try again later.
        </div>
    }
}

@using (Html.BeginForm("GetCrewWiseDocumentList", "CrewDocument", FormMethod.Post))
{

    <div class="row mb-3">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Current Crew Documents</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("GetCrewWiseDocumentList", "CrewDocument", FormMethod.Post, new { id = "crewDetailForm" }))
                    {
                        <div class="input-group">
                            @Html.TextBox("StaffNumber", staffNumberValue, new { @class = "form-control mr-2", type = "number", id = "StaffNumber" })
                            <div class="input-group-append">
                                <button class="btn btn-info btn-outline-secondary" type="submit">Get Latest Documents</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Past Records</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("ShowAllHistoryDocuments", "CrewDocument", FormMethod.Post, new { id = "pastRecordsForm" }))
                    {
                        <button class="btn btn-info btn-outline-secondary" type="submit">Show Past Records</button>
                        @Html.Hidden("StaffNumber", staffNumberValue, new { id = "PastStaffNumber" })
                    }
                </div>
            </div>
        </div>
    </div>
}

<table id="TableData" class="table table-striped table-hover my-0">
    <thead>
        <tr style="height: 10px;">
            <th class="text-center fw-bold">#</th>
            <th class="text-center fw-bold">Staff Number</th>
            <th class="text-center fw-bold">Staff Name</th>
            <th class="text-center fw-bold">Document Type</th>
            <th class="text-center fw-bold">Submitted Time</th>
            <th class="text-center fw-bold">Crew Comments</th>
            <th class="text-center fw-bold">Status</th>
            <th class="text-center fw-bold">Admin Comments</th>
            <th class="text-center fw-bold">Attachment Path</th>
            <th class="text-center fw-bold">Approve</th>
            <th class="text-center fw-bold">Reject</th>
            <th class="text-center fw-bold">History</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            int i = 1;
            for (int j = 0; j < Model.Count; j++)
            {
                eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();
                var staffNumber = Model[j].StaffNumber;
                var stffinfo = db.PilotCrewDetails.Where(a => a.StaffNumber == staffNumber).FirstOrDefault();
                string stfName = stffinfo.FullName ?? "";

                <tr>
                    <td class="text-center">@i</td>
                    <td class="text-center">@(Model[j].StaffNumber)</td>
                    <td class="text-center">@(stfName)</td>
                    <td class="text-center">@(Model[j].CrewDocumentCategory.CategoryName)</td>
                    <td class="text-center">@(Model[j].Submited_DT.Value.ToString("dd MMM hh:mm tt"))</td>
                    <td class="text-center">@(Model[j].Comments)</td>
                    @{
                        var statusStr = "";
                        var status = Model[j].Status;
                        if (status == "S")
                        {
                            statusStr = "Submitted";
                        }
                        else if (status == "A")
                        {
                            statusStr = "Approved";
                        }
                        else if (status == "R")
                        {
                            statusStr = "Awaiting Resubmission";
                        }
                        else if (status == "C")
                        {
                            statusStr = "Resubmitted";
                        }
                    }

                    <td class="text-center">@(statusStr)</td>
                    <td class="text-center">@(Model[j].Admin_Reason)</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(Model[j].Attachment_Path))
                        {
                            <a href="@Url.Content(Model[j].Attachment_Path)" target="_blank" title="View Document">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file align-middle">
                                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9l-7-7z"></path>
                                    <polyline points="13 2 13 9 20 9"></polyline>
                                </svg>
                            </a>
                        }
                        else
                        {
                            <span>No Document</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (status != "A" && status != "R")
                        {
                            <a href="#" class="approveLink" data-id="@(Model[j].Id)" title="Approve Leave">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="green" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-circle"><path d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2s10 4.477 10 10zm-3-3.46l-5.17 6.01-2.51-2.91a1 1 0 0 1 1.42-1.42l2.09 2.43 4.59-5.32a1 1 0 0 1 1.42 1.42z"></path></svg>
                            </a>
                        }
                    </td>
                    <td class="text-center">
                        @if (status != "A" && status != "R")
                        {
                            <a href="#" class="rejectLink" data-id="@(Model[j].Id)" title="Reject Leave">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x-circle"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                            </a>
                        }
                    </td>
                    <td class="text-center">
                        <a href="#" class="showHistory" data-documentid="@(Model[j].Id)" title="View History" style="text-decoration: none;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock align-middle">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </a>
                    </td>
                </tr>
                i++;
            }
        }
    </tbody>
</table>

<div class="modal fade" id="commentModal" tabindex="-1" aria-labelledby="commentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentModalLabel">Enter Comments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="adminComments" class="form-control" rows="3"></textarea>
                <input type="hidden" id="documentId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveComment">Save changes</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rejectModalLabel">Reject Document</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Select Reason(s):</label>
                    <div id="rejectReasonsContainer">
                        <div class="text-center py-3">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading rejection reasons...</p>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="rejectComments" class="form-label fw-bold">Additional Comments:</label>
                    <textarea id="rejectComments" class="form-control" rows="3" placeholder="Enter additional comments (optional)"></textarea>
                </div>
                <input type="hidden" id="rejectDocumentId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmReject">Confirm Rejection</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="historyModal" tabindex="-1" aria-labelledby="historyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="historyModalLabel">Document Status History</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="historyModalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $(document).ready(function () {
        var currentPageInput = $('#currentPage');
        var staffNumberInput = $('#StaffNumber');
        var pastRecordsStaffNumber = $('#PastStaffNumber'); // Get the hidden input in the past records form
        table = $('#TableData').DataTable({
            dom: 'Bfrtip',
            order: [[0, 'asc']],
            columnDefs: [
                {
                    type: 'time-date-sort',
                    targets: [4],
                }
            ],
            buttons: [
                {
                    extend: 'excel',
                    title: 'Documents List',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5, 6, 7, 8]
                    }
                }
            ],
            initComplete: function () {
                var api = this.api();
                currentPageInput.val(api.page.info().page + 1);
            }
        });

        // Update the hidden StaffNumber in the past records form on input change
        staffNumberInput.on('input', function () {
            pastRecordsStaffNumber.val($(this).val());
        });

        let clickedButtonType = ""; // Store the button type
        $('.approveLink').click(function (e) {
            e.preventDefault();
            var documentId = $(this).data('id');
            $('#documentId').val(documentId);
            $('#adminComments').val('');
            $('#commentModal').modal('show');
        });

        $('#saveComment').click(function () {
            var documentId = $('#documentId').val();
            var adminComments = $('#adminComments').val();

            $.ajax({
                type: "POST",
                url: "/CrewDocument/ApproveDocument",
                data: { Id: documentId, AdminComments: adminComments },
                success: function (response) {
                    $('#commentModal').modal('hide');
                    location.reload();
                    alert("Document Approved");
                },
                error: function (error) {
                    alert("Error: " + error.statusText);
                }
            });
        });

        // Reject Document
        $('.rejectLink').click(function (e) {
            e.preventDefault();
            var documentId = $(this).data('id');
            $('#rejectDocumentId').val(documentId);

            // Clear previous selections
            $('#rejectComments').val('');

            // Show loading spinner
            $('#rejectReasonsContainer').html('<div class="text-center py-3"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><p class="mt-2">Loading rejection reasons...</p></div>');

            // Load reject reasons from server
            $.ajax({
                type: "GET",
                url: "/CrewDocument/GetRejectReasons",
                success: function (reasons) {
                    var html = '';
                    if (reasons && reasons.length > 0) {
                        html += '<div class="reject-reasons-list" style="max-height: 200px; overflow-y: auto;">';
                        reasons.forEach(function (reason) {
                            html += `<div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" value="${reason.Id}" id="reason_${reason.Id}">
                        <label class="form-check-label" for="reason_${reason.Id}">
                            ${reason.Description}
                        </label>
                    </div>`;
                        });
                        html += '</div>';
                    } else {
                        html = '<p class="text-muted">No rejection reasons available</p>';
                    }
                    $('#rejectReasonsContainer').html(html);
                    $('#rejectModal').modal('show');
                },
                error: function (error) {
                    $('#rejectReasonsContainer').html('<p class="text-danger">Error loading rejection reasons. Please try again.</p>');
                }
            });
        });

        $('#confirmReject').click(function () {
            var documentId = $('#rejectDocumentId').val();
            var comments = $('#rejectComments').val();
            var selectedReasons = [];

            // Get selected checkboxes
            $('#rejectReasonsContainer input[type="checkbox"]:checked').each(function () {
                selectedReasons.push($(this).val());
            });

            if (selectedReasons.length === 0 && comments.trim() === '') {
                alert('Please select at least one reason or provide comments');
                return;
            }

            $.ajax({
                type: "POST",
                url: "/CrewDocument/RejectDocument",
                data: {
                    Id: documentId,
                    AdminComments: comments,
                    RejectReasonIds: selectedReasons
                },
                success: function (response) {
                    $('#rejectModal').modal('hide');

                    // Then show the alert after a small delay to ensure modal is hidden
                    setTimeout(function () {
                        alert("Document has been rejected and requires resubmission");
                        // Reload after alert is dismissed
                        location.reload();
                    }, 100);
                },
                error: function (error) {
                    alert("Error: " + error.statusText);
                }
            });
        });


        // Handle the click event for the "History" button
        // Handle history button click
        // Handle history button click
        $(document).on('click', '.showHistory', function () {
            var documentId = $(this).data('documentid');
            showDocumentHistory(documentId);
        });

        function showDocumentHistory(documentId) {
            $('#historyModalBody').empty().html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Loading history...</p></div>');
            $('#historyModal').modal('show');

            $.ajax({
                type: "GET",
                url: "/CrewDocument/GetDocumentHistory",
                data: { documentId: documentId },
                success: function (historyData) {
                    if (historyData && historyData.length > 0) {
                        renderHistory(historyData);
                    } else {
                        $('#historyModalBody').html('<div class="alert alert-info">No history available for this document.</div>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching document history:", error);
                    $('#historyModalBody').html('<div class="alert alert-danger">Error loading history. Please try again.</div>');
                }
            });
        }

        function renderHistory(historyData) {
            var historyHtml = '';

            historyData.forEach(function (historyItem) {
                var statusText = getStatusText(historyItem.Status);
                var changeDate = formatDate(historyItem.Change_DT);

                historyHtml += '<div class="card mb-3">';
                historyHtml += '<div class="card-header d-flex justify-content-between align-items-center">';
                historyHtml += '<h5 class="mb-0">' + statusText + '</h5>';
                historyHtml += '<span class="badge ' + getStatusBadgeClass(historyItem.Status) + '">' + statusText + '</span>';
                historyHtml += '</div>';
                historyHtml += '<div class="card-body">';
                historyHtml += '<p><strong>Date:</strong> ' + changeDate + '</p>';

                // Add rejection reasons if status is Rejected
                if (historyItem.Status === 'R') {
                    historyHtml += '<div class="rejection-reasons mt-3" data-history-id="' + historyItem.Id + '">';
                    historyHtml += '<div class="reasons-loading text-center py-2">';
                    historyHtml += '<div class="spinner-border spinner-border-sm" role="status"></div>';
                    historyHtml += '<span class="ms-2">Loading rejection reasons...</span>';
                    historyHtml += '</div>';
                    historyHtml += '</div>';
                }

                // Add comments if available
                if (historyItem.Comments) {
                    historyHtml += '<div class="mt-2">';
                    historyHtml += '<strong>Comments:</strong>';
                    historyHtml += '<p class="mb-0">' + historyItem.Comments + '</p>';
                    historyHtml += '</div>';
                }

                // Add attachment if available
                if (historyItem.AttachmentPath) {
                    historyHtml += '<div class="mt-2">';
                    historyHtml += '<strong>Attachment:</strong>';
                    historyHtml += '<p class="mb-0">';
                    historyHtml += '<a href="' + historyItem.AttachmentUrl + '" target="_blank" class="btn btn-sm btn-outline-primary">';
                    historyHtml += '<i class="fas fa-file-download"></i> Download';
                    historyHtml += '</a>';
                    historyHtml += '</p>';
                    historyHtml += '</div>';
                }

                historyHtml += '</div></div>';
            });

            $('#historyModalBody').html(historyHtml);

            // Load rejection reasons for all rejected items
            $('.rejection-reasons').each(function () {
                loadRejectionReasons($(this).data('history-id'), $(this));
            });
        }

        function loadRejectionReasons(historyId, container) {
            $.ajax({
                type: "GET",
                url: "/CrewDocument/GetRejectionReasonsForHistory",
                data: { historyId: historyId },
                success: function (response) {
                    container.find('.reasons-loading').remove();

                    if (response.success) {
                        if (response.data && response.data.length > 0) {
                            var reasonsHtml = '<div class="alert alert-danger p-2">';
                            reasonsHtml += '<strong>Rejection Reasons:</strong>';
                            reasonsHtml += '<ul class="mb-0">';

                            response.data.forEach(function (item) {
                                reasonsHtml += '<li>' + (item.Reason || "No reason specified") + '</li>';
                            });

                            reasonsHtml += '</ul></div>';
                            container.html(reasonsHtml);
                        } else {
                            container.html('<div class="alert alert-info">' +
                                (response.message || "No rejection reasons recorded") + '</div>');
                        }
                    } else {
                        container.html('<div class="alert alert-danger">' +
                            (response.error || "Error loading rejection reasons") + '</div>');
                    }
                },
                error: function (xhr, status, error) {
                    container.find('.reasons-loading').remove();
                    container.html('<div class="alert alert-danger">Error loading rejection reasons: ' +
                        error + '</div>');
                }
            });
        }

        function showError(container, message) {
            container.find('.reasons-loading').remove();
            container.html('<div class="alert alert-danger">' + message + '</div>');
        }

        // Helper functions remain the same
        function formatDate(dateString) {
            if (!dateString) return "Date not available";

            try {
                // Handle Microsoft JSON date format: "/Date(epoch)/"
                if (dateString.startsWith("/Date(") && dateString.endsWith(")/")) {
                    const epoch = parseInt(dateString.substring(6, dateString.length - 2));
                    return new Date(epoch).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    });
                }

                // Try standard ISO format
                let date = new Date(dateString);

                if (isNaN(date.getTime())) {
                    // Try parsing as milliseconds
                    date = new Date(parseInt(dateString));
                }

                if (isNaN(date.getTime())) {
                    return "Date not available";
                }

                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            } catch (e) {
                console.error("Error formatting date:", e);
                return "Date not available";
            }
        }

        function getStatusText(statusCode) {
            switch (statusCode) {
                case 'S': return 'Submitted';
                case 'A': return 'Approved';
                case 'R': return 'Rejected';
                case 'C': return 'Resubmitted';
                default: return statusCode;
            }
        }

        function getStatusBadgeClass(statusCode) {
            switch (statusCode) {
                case 'S': return 'bg-primary';
                case 'A': return 'bg-success';
                case 'R': return 'bg-danger';
                case 'C': return 'bg-warning text-dark';
                default: return 'bg-secondary';
            }
        }
    });
</script>