@model List<eBriefingWebApp.PreFlight_CrewTest>
@{
    ViewBag.Title = "Test Second Chance";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title mb-0">@ViewBag.Title</h5>
                    </div>
                </div>
            </div>
            <table id="TableData" class="table table-striped table-hover my-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold">Staff Number</th>
                        <th class="text-center fw-bold">Full Name</th>
                        <th class="text-center fw-bold">Flight #</th>
                        <th class="text-center fw-bold">Flight Date</th>
                        <th class="text-center fw-bold">Test Date/Time</th>
                        <th class="text-center fw-bold">Status</th>
                        <th class="text-center fw-bold">Cancel Second Chance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.OCB_CrewPos.StaffNumber</td>
                            <td class="text-left">@item.OCB_CrewPos.CrewDetail.FullName</td>
                            <td class="text-center">@item.OCB_Flights.Flt_No</td>
                            <td class="text-center">@item.OCB_Flights.Flight_Date.Value.ToString("dd MMM yyyy")</td>
                            <td class="text-center">@item.TestDateTime.Value.ToString("dd MMM yyyy hh:mm tt")</td>
                            <td class="text-center">@item.IsFaildTest.Value.ToString().Replace("True", "Faild")</td>
                            <td class="text-center">
                                <a href="@Url.Action("CancelSecondChance", "PreFlight", new { Id = item.Id})" title="Cancel Second Chance">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-slash align-middle me-2"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@if (TempData["Status"] != null)
{

    if (TempData["Status"].ToString() == "Added")
    {
        <script>
            toastr.success('Record Added.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Saved")
    {
        <script>
            toastr.success('Record Saved.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Exist")
    {
        <script>
            toastr.warning('Record Exist.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Error")
    {
        <script>
            toastr.error('Error Saving Record.');
        </script>
    }
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        order: [[4, 'asc']],
        columnDefs: [
            {
                type: 'time-date-sort',
                targets: [4],
            },
            {
                target: [6],
                visible: false,
                searchable: false,
            }
        ],
        buttons: [
            {
                extend: 'excel',
                title: 'TestSecondChance',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4, 5]
                }
            }
        ]
    });
</script>
