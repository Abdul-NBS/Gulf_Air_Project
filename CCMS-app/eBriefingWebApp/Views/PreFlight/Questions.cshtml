@model List<eBriefingWebApp.PreFlight_TestQuestions>
@{
    ViewBag.Title = "Manage Pre-Flight Questions";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title mb-0">@ViewBag.Title</h5>
                    </div>
                    <div class="col-md-4 justify-content-end">
                        <div class="input-group mb-3 justify-content-end">
                            <a href="@Url.Action("AddNewQuestion", "PreFlight")" class="btn btn-dark btn-sm" type="submit">Add New</a>
                        </div>
                    </div>
                </div>
            </div>
            <table id="TableData" class="table table-striped table-hover my-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold">Fleet</th>
                        <th class="text-center fw-bold">Category</th>
                        <th class="text-center fw-bold">Question</th>
                        <th class="text-center fw-bold">Active</th>
                        <th class="text-center fw-bold">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.PreFlight_Categories.Fleet.Fleet1</td>
                            <td class="text-left">@item.PreFlight_Categories.Category</td>
                            <td class="text-left">@item.Question</td>
                            <td class="text-center">@item.Active</td>
                            <td class="text-center">
                                <a href="@Url.Action("EditQuestion", "PreFlight", new { Id = item.Id})" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <a href="@Url.Action("ManageAnswers", "PreFlight", new { Id = item.Id})" title="Edit Answers">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'QuestionsList',
                exportOptions: {
                    columns: [0, 1, 2, 3]
                }
            }
        ]
    });
</script>
