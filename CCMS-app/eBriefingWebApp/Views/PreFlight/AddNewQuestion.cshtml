@model eBriefingWebApp.PreFlight_TestQuestions
@{
    ViewBag.Title = "Add New Question";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("AddNewQuestion", "PreFlight", FormMethod.Post))
{
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Question Detail</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label>Fleet</label>
                        @Html.DropDownList("FleetId", new SelectList(ViewBag.FleetsList, "Id", "Fleet1"), "Select Fleet", new { @class = "form-select mb-3" })

                    </div>

                    <div class="form-group">
                        <label>Category</label>
                        @Html.DropDownList("CategoryId", new SelectList(string.Empty), "Select Category", new
                        {
                            @id = "CategoryId",
                            @class = "form-select mb-3"
                        })
                    </div>

                    <div class="form-group">
                        <label>Question</label>
                        @Html.TextAreaFor(m => @Model.Question, new { @class = "form-control" })
                    </div>

                </div>
                <div class="card-footer">
                    <button class="btn btn-dark" type="submit">Add New</button>
                    <a href="@Url.Action("Questions", "PreFlight")" class="btn btn-dark" type="submit">Back</a>
                </div>
            </div>
        </div>
    </div>

    if (TempData["Status"] != null)
    {

        if (TempData["Status"].ToString() == "Added")
        {
            <script>
                toastr.success('Record Added.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Exist")
        {
            <script>
                toastr.warning('Record Exist.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }
}

<script type="text/javascript">

    $(document).ready(function () {
        $("#FleetId").change(function () {
            var SelecedVal = $(this).val();
            $("#CategoryId").html('');
            $("#CategoryId").append($("<option></option>").attr("value", '')
                .text('Select Category'));
            if (SelecedVal != '') {
                $.get('/PreFlight/GetCategoriesList/',
                    {
                        "FleetId": SelecedVal
                    }).success(function (data) {
                        for (var i = 0; i < data.length; i++) {
                            $("#CategoryId").append($("<option></option>").attr("value", data[i].Id)
                                .text(data[i].Category));
                        }
                    })
            }
        });
    })
</script>

