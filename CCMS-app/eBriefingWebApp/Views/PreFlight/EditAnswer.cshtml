@model eBriefingWebApp.PreFlight_Answers
@{
    ViewBag.Title = "Edit Answer";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("EditAnswer", "PreFlight", FormMethod.Post))
{
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Add New Answer</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label style="font-weight:bold;">Question</label>
                        <br />
                        @Model.PreFlight_TestQuestions.Question
                        @Html.HiddenFor(m => m.ID)
                        @Html.HiddenFor(m => m.QuestionID)
                    </div>

                    <div class="form-group">
                        <label style="font-weight:bold;">Answer Text</label>
                        @Html.TextAreaFor(m => @Model.AnswerText, new { @class = "form-control" })
                    </div>

                    <div class="form-group">
                        <label style="font-weight:bold;">Answer Correct/Wrong</label>
                        @Html.DropDownList("Answer", new SelectList(ViewBag.Answer, "Value", "Text", @Model.Answer), "Select Answer", new { @class = "form-select mb-3" })
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-dark" type="submit">Save changes</button>
                    <a href="@Url.Action("ManageAnswers", "PreFlight", new { Id = Model.QuestionID})" class="btn btn-dark" type="submit">Back</a>
                </div>
            </div>
        </div>
    </div>

    if (TempData["Status"] != null)
    {

        if (TempData["Status"].ToString() == "Added")
        {
            <script>
                toastr.success('Record Added.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Exist")
        {
            <script>
                toastr.warning('Record Exist.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }
}