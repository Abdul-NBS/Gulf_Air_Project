@model List<eBriefingWebApp.PreFlight_CrewTest>
@{
    ViewBag.Title = "All Crew Failed The Test";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>
@using (Html.BeginForm("AllCrewFailedTest", "PreFlight", FormMethod.Post))

{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3">
                                <span style="font-weight:bold">From &nbsp; &nbsp; </span> <input name="From_Block_Date" id="From_Block_Date" value="@Convert.ToDateTime(TempData["From_Block_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                &nbsp;<span style="font-weight:bold"> - &nbsp;  To &nbsp; &nbsp; </span>  <input name="To_Block_Date" id="To_Block_Date" value="@Convert.ToDateTime(TempData["To_Block_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                <div class="input-group-append">
                                    <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Staff Number</th>
                            <th class="text-center fw-bold">Full Name</th>
                            <th class="text-center fw-bold">Flight #</th>
                            <th class="text-center fw-bold">Date</th>
                            <th class="text-center fw-bold">Correct</th>
                            <th class="text-center fw-bold">Wrong</th>
                            <th class="text-center fw-bold">Correct Answer Count In Each Attempt</th>
                            <th class="text-center fw-bold">Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@item.OCB_CrewPos.StaffNumber</td>
                                <td class="text-left">@item.OCB_CrewPos.CrewDetail.FullName</td>
                                <td class="text-center">@item.OCB_Flights.Flt_No</td>
                                <td class="text-center">@item.OCB_Flights.Flight_Date.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.PreFlight_TestLog.Where(a => a.PreFlight_Answers.Answer == true).Count()</td>
                                <td class="text-center">@item.PreFlight_TestLog.Where(a => a.PreFlight_Answers.Answer == false).Count()</td>

                                @{
                                    int noOfQtns = item.PreFlight_TestLog.Count;

                                    int noOFattempts = noOfQtns / 3;
                                    String correctAnswerCount = "";
                                    for (int k = 0; k < noOFattempts; k++)
                                    {
                                        // Calculate the starting index for each set of 3 questions
                                        int startIndex = k * 3;

                                        // Extract the set of 3 questions
                                        var answersetSet = item.PreFlight_TestLog.Skip(startIndex).Take(3).ToList();
                                        int count = k + 1;
                                        var correctAnswer = answersetSet.Where(a => a.PreFlight_Answers.Answer == true).ToList().Count();
                                        String answerDetail = correctAnswer + "/";
                                        // correctAnswerCount += answerDetail;

                                        if (k == noOFattempts - 1) // Check if it's the last iteration
                                        {
                                            correctAnswerCount += correctAnswer.ToString(); // Append without "/"
                                        }
                                        else
                                        {
                                            correctAnswerCount += answerDetail; // Append with "/"
                                        }
                                    }



                                }

                                <td class="text-center">@correctAnswerCount</td>
                                <td class="text-center">
                                    <a href="@Url.Action("AddFailedComment", "PreFlight", new { Id = item.Id })" title="Add Comment">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-message-square align-middle me-2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </a>
                                    <a href="@Url.Action("AddToSecondChance", "PreFlight", new { Id = item.Id, FlightId = item.FlightId })" title="Allow Second Chance">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-rotate-cw align-middle me-2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                                    </a>
                                </td>
                            </tr>
                                    }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
                                    }
    @if (TempData["Status"] != null)
    {

        if (TempData["Status"].ToString() == "Added")
        {
            <script>
                toastr.success('Record Added.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Exist")
        {
            <script>
                toastr.warning('Record Exist.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }

    <script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
    <script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
    <link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
    <link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script>
        $('#TableData').dataTable({
            dom: 'Bfrtip',
            order: [[3, 'desc']],
            columnDefs: [
                {
                    type: 'time-date-sort',
                    targets: [3],
                },
                {
                    target: [6],
                    visible: false,
                    searchable: false,
                }
            ],
            buttons: [
                {
                    extend: 'excel',
                    title: 'AllCrewFailedTest',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5]
                    }
                }
            ]
        });
    </script>
