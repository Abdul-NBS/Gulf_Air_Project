@model List<eBriefingWebApp.PreFlight_Answers>
@{
    ViewBag.Title = "Manage Answers";
    Layout = "~/Views/Shared/_layout.cshtml";
}


<div class="row">
    <div class="col-md-12">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title mb-0" style="color:black;">@ViewBag.QuestionTitle</h5>
                    </div>
                    <div class="col-md-4 justify-content-end">
                        <div class="input-group mb-3 justify-content-end">
                            <a href="@Url.Action("AddNewAnswer", "PreFlight", new { Id = @ViewBag.QuestionId})" class="btn btn-dark btn-sm" type="submit">Add New</a>
                        </div>
                    </div>
                </div>
            </div>
            <table class="table table-striped table-hover my-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold">Answer Text</th>
                        <th class="text-center fw-bold">Answer (Correct/Wrong)</th>
                        <th class="text-center fw-bold">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-left">@item.AnswerText</td>
                            <td class="text-center">@item.Answer</td>
                            <td class="text-center">
                                <a href="@Url.Action("EditAnswer", "PreFlight", new { Id = item.ID})" title="Edit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <a href="@Url.Action("DeleteAnswer", "PreFlight", new { Id = item.ID})" title="Delete Answers">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2 align-middle me-2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="card-footer">
                <a href="@Url.Action("Questions", "PreFlight")" class="btn btn-dark" type="submit">Back</a>
            </div>
        </div>
    </div>

</div>