@model List<eBriefingWebApp.PreFlight_CrewTest>
@{
    ViewBag.Title = "Flight Test History";
    Layout = "~/Views/Shared/_layout.cshtml";
}

@using (Html.BeginForm("FlightTestHistory", "PreFlight", FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3 justify-content-end">
                                <input name="FlightNumber" id="FlightNumber" type="text" class="form-control" placeholder="Flight Number" aria-describedby="button-addon2">
                                <button class="btn btn-dark btn-sm" type="submit">Get Flight History</button>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Flight Number</th>
                            <th class="text-center fw-bold">Date</th>
                            <th class="text-center fw-bold">Orig/Dest</th>
                            <th class="text-center fw-bold">Total Test Taken</th>
                            <th class="text-center fw-bold">Total Crew</th>
                            <th class="text-center fw-bold">Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.GroupBy(a => new
                        {
                            a.FlightId,
                            a.OCB_Flights,
                        }))
                        {
                            <tr>
                                <td class="text-center">@item.Key.OCB_Flights.Flt_No</td>
                                <td class="text-center">@item.Key.OCB_Flights.Flight_Date.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.Key.OCB_Flights.Orig / @item.Key.OCB_Flights.Dest</td>
                                <td class="text-center">@item.Key.OCB_Flights.PreFlight_CrewTest.Count()</td>
                                <td class="text-center">@item.Key.OCB_Flights.OCB_Blocks.OCB_CrewPos.Count()</td>
                                <td class="text-center">
                                    <a href="@Url.Action("FlightTestDetail", "PreFlight", new { Id = item.Key.FlightId})" title="Edit Answers">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        order: [[2, 'desc']],
        columnDefs: [
            {
                type: 'time-date-sort',
                targets: [2],
            },
            {
                target: [5],
                visible: false,
                searchable: false,
            }
        ],
        buttons: [
            {
                extend: 'excel',
                title: 'FlightTestHistory',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4]
                }
            }
        ]
    });
</script>