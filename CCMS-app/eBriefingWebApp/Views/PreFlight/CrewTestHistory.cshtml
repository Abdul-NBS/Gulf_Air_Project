@model List<eBriefingWebApp.PreFlight_CrewTest>
@{
    ViewBag.Title = "Crew Test History";
    Layout = "~/Views/Shared/_layout.cshtml";
}

@using (Html.BeginForm("CrewTestHistory", "PreFlight", FormMethod.Post))
{
    if (ViewBag.CrewSummery != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="card flex-fill">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Crew Test Summery</h5>
                    </div>
                    <table class="table table-striped table-hover my-0">
                        <thead>
                            <tr>
                                <th class="text-center fw-bold">Total Flights</th>
                                <th class="text-center fw-bold">Total Correct</th>
                                <th class="text-center fw-bold">Total Wrong</th>
                                <th class="text-center fw-bold">Total Pass</th>
                                <th class="text-center fw-bold">Total Fail</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-center">@ViewBag.CrewSummery.TotalFlights</td>
                                <td class="text-center">@ViewBag.CrewSummery.TotalCorrect</td>
                                <td class="text-center">@ViewBag.CrewSummery.TotalWrong</td>
                                <td class="text-center">@ViewBag.CrewSummery.TotalPass</td>
                                <td class="text-center">@ViewBag.CrewSummery.TotalFail</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3 justify-content-end">
                                <input name="StaffNumber" id="StaffNumber" type="text" class="form-control" placeholder="Staff Number" aria-describedby="button-addon2">
                                <button class="btn btn-dark btn-sm" type="submit">Get Crew History</button>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">#</th>
                            <th class="text-center fw-bold">Flight Number</th>
                            <th class="text-center fw-bold">Date</th>
                            <th class="text-center fw-bold">Orig/Dest</th>
                            <th class="text-center fw-bold">Correct Answers</th>
                            <th class="text-center fw-bold">Wrong Answers</th>
                            <th class="text-center fw-bold">Attempt wise Correct Answer Count</th>
                            <th class="text-center fw-bold">Pass / Fail</th>
                            <th class="text-center fw-bold">Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1;
                            foreach (var item in Model)
                            {
                                                <tr>
                                                    <td class="text-center">@i</td>
                                                    <td class="text-center">@item.OCB_Flights.Flt_No</td>
                                                    <td class="text-center">@item.OCB_Flights.Flight_Date.Value.ToString("dd MMM yyyy")</td>
                                                    <td class="text-center">@item.OCB_Flights.Orig / @item.OCB_Flights.Dest</td>
                                                    <td class="text-center">@item.PreFlight_TestLog.Where(a => a.CrewTestId == item.Id && a.PreFlight_Answers.Answer == true).Count()</td>
                                                    <td class="text-center">@item.PreFlight_TestLog.Where(a => a.CrewTestId == item.Id && a.PreFlight_Answers.Answer == false).Count()</td>
                                                    @{
                                                        int noOfQtns = item.PreFlight_TestLog.Count;

                                                        int noOFattempts = noOfQtns / 3;
                                                        String correctAnswerCount = "";
                                                        for (int k = 0; k < noOFattempts; k++)
                                                        {
                                                            // Calculate the starting index for each set of 3 questions
                                                            int startIndex = k * 3;

                                                            // Extract the set of 3 questions
                                                            var answersetSet = item.PreFlight_TestLog.Skip(startIndex).Take(3).ToList();
                                                            int count = k + 1;
                                                            var correctAnswer = answersetSet.Where(a => a.PreFlight_Answers.Answer == true).ToList().Count();
                                                            String answerDetail = correctAnswer + "/";
                                                            // correctAnswerCount += answerDetail;

                                                            if (k == noOFattempts - 1) // Check if it's the last iteration
                                                            {
                                                                correctAnswerCount += correctAnswer.ToString(); // Append without "/"
                                                            }
                                                            else
                                                            {
                                                                correctAnswerCount += answerDetail; // Append with "/"
                                                            }
                                                        }

                                                        eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();

                                                        var answerCount = item.PreFlight_TestLog.Count();
                                                        int totalCorrect = 0;
                                                        int totalWrong = 0;
                                                        if (answerCount == 3)
                                                        {

                                                            totalCorrect = item.PreFlight_TestLog.Where(a => a.PreFlight_Answers.Answer == true).Count();
                                                            totalWrong = item.PreFlight_TestLog.Where(a => a.PreFlight_Answers.Answer == false).Count();
                                                        }
                                                        else if (answerCount == 6 || answerCount == 9)
                                                        {
                                                            var getAnswerListSecondChance = db.PreFlight_TestLog.Where(a => a.CrewTestId == item.Id).OrderByDescending(record => record.id).Take(3).ToList();
                                                            int trueCount = getAnswerListSecondChance.Where(record => record.PreFlight_Answers != null && record.PreFlight_Answers.Answer == true).Count();

                                                            int falseCount = getAnswerListSecondChance.Where(record => record.PreFlight_Answers != null && record.PreFlight_Answers.Answer == false).Count();
                                                            totalCorrect = trueCount;
                                                            totalWrong = falseCount;
                                                        }
                                                        string Status = "";
                                                        if (totalCorrect > totalWrong)
                                                        {
                                                            Status = "Passed";
                                                        }
                                                        else
                                                        {
                                                            Status = "Failed";
                                                        }


                                                    }

                                                    <td class="text-center">@correctAnswerCount</td>

                                                    <td class="text-center">
                                                        @if (Status == "Passed")
                                                        {
                                                            <span class="badge bg-success">Passed</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Failed</span>
                                                        }
                                                    </td>

                                                    <td class="text-center">
                                                        <a href="@Url.Action("CrewTestDetail", "PreFlight", new { Id = item.Id })" title="Edit Answers">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                                        </a>
                                                    </td>
                                                </tr>
                                i++;
                            }
                            }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        order: [[0, 'asc']],
        columnDefs: [
            {
                type: 'time-date-sort',
                targets: [1],
            },
            {
                target: [5],
                visible: false,
                searchable: false,
            }
        ],
        buttons: [
            {
                extend: 'excel',
                title: 'CrewTestHistory',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4]
                }
            }
        ]
    });
</script>