@model List<eBriefingWebApp.OCB_CrewPos>
@{
    ViewBag.Title = "All Crew With No Test";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.8.4/moment.min.js"></script>
<script src="https://cdn.datatables.net/plug-ins/1.12.1/sorting/datetime-moment.js"></script>


@using (Html.BeginForm("AllCrewWithNoTest", "PreFlight", FormMethod.Post))
{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-4 justify-content-end">
                            <div class="input-group mb-3">
                                <input name="Flight_Date" id="Flight_Date" value="@Convert.ToDateTime(TempData["Flight_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                <div class="input-group-append">
                                    <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Staff#</th>
                            <th class="text-center fw-bold">Full Name</th>
                            <th class="text-center fw-bold">Block#</th>
                            <th class="text-center fw-bold">Flight#</th>
                            <th class="text-center fw-bold">Start Date</th>
                            <th class="text-center fw-bold">Start Time</th>
                            <th class="text-center fw-bold">Orig/Dest</th>
                            <th class="text-center fw-bold">Status</th>
                            <th class="text-center fw-bold">Exception</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderBy(a => a.OCB_Blocks.Block_No))
                        {
                            var flight = @item.OCB_Blocks.OCB_Flights.Where(a => a.BlockId == item.BlockId).FirstOrDefault();
                            var checkIsFailed = item.PreFlight_CrewTest.Where(a => a.OCB_CrewPos.StaffNumber == item.StaffNumber && a.IsFaildTest == true).FirstOrDefault();

                            string rowColor = "";
                            string rowTitle = "";

                            if (checkIsFailed != null)
                                rowColor = "table-danger";

                            if (checkIsFailed != null)
                                rowTitle = "Failed the Test";

                            <tr class="@rowColor" title="@rowTitle">
                                <td class="text-center">@item.StaffNumber</td>
                                <td class="text-left">@item.CrewDetail.FullName</td>
                                <td class="text-center">@flight.OCB_Blocks.Block_No</td>
                                <td class="text-center">@flight.Flt_No</td>
                                <td class="text-center">@flight.OCB_Blocks.Start_Time.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@flight.OCB_Blocks.Start_Time.Value.ToString("HH:mm")</td>
                                <td class="text-center">@flight.Orig / @flight.Dest</td>
                                <td class="text-center">
                                    @if (checkIsFailed != null)
                                    {
                                        <text>1</text>
                                    }
                                    else
                                    {
                                        <text>0</text>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("AddExceptionMessage", "PreFlight", new { Id = item.Id, FlightId = flight.Id })" title="Add Comment">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-message-square align-middle me-2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                    </a>
                                    <a href="@Url.Action("AddToSecondChance", "PreFlight", new { Id = item.Id, FlightId = flight.Id })" title="Allow Second Chance">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-rotate-cw align-middle me-2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                                    </a>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

}

    @if (TempData["Status"] != null)
    {

        if (TempData["Status"].ToString() == "Added")
        {
            <script>
                toastr.success('Record Added.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Saved")
        {
            <script>
                toastr.success('Record Saved.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Exist")
        {
            <script>
                toastr.warning('Record Exist.');
            </script>
        }
        else if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Saving Record.');
            </script>
        }
    }

    <script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
    <script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
    <link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
    <script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
    <link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
    <script>

        $('#TableData').dataTable({
            dom: 'Bfrtip',
            order: [[5, 'asc']],
            columnDefs: [
                {
                    type: 'time-date-sort',
                    targets: [5],
                },
                {
                    target: [7],
                    visible: false,
                    searchable: false,
                }
            ],
            buttons: [
                {
                    extend: 'excel',
                    title: 'AllCrewNoTest',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4, 5, 6]
                    }
                }
            ]
        });

        const table = $('#TableData').DataTable();
        // Get the column API object
        const column = table.column(7); // gets 2nd column (0-indexed)
        // Toggle the visibility
        column.visible(!column.visible()); // true or false

    </script>
