@model List<eBriefingWebApp.OutOfBase>
@{
    ViewBag.Title = "Out Of Base";
    Layout = "~/Views/Shared/_layout.cshtml";
}

@using (Html.BeginForm())
{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>
                        <div class="col-md-6 justify-content-end">
                            <div class="input-group mb-3 justify-content-end">
                                <input name="FromDate" id="FromDate" type="date" value="@(ViewBag.FromDate == null ? "" : Convert.ToDateTime(ViewBag.FromDate).ToString("yyyy-MM-dd"))" class="form-control" placeholder="From Date" aria-describedby="button-addon2">
                                <input name="ToDate" id="ToDate" type="date" value="@(ViewBag.ToDate == null ? "" : Convert.ToDateTime(ViewBag.ToDate).ToString("yyyy-MM-dd"))" class="form-control" placeholder="To Date" aria-describedby="button-addon2">
                                <button class="btn btn-dark btn-sm" type="submit">Get List</button>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Staff Number</th>
                            <th class="text-center fw-bold">Full Name</th>
                            <th class="text-center fw-bold">Date From</th>
                            <th class="text-center fw-bold">Date To</th>
                            <th class="text-center fw-bold">Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">@item.StaffNumber</td>
                                <td class="text-left">@item.CrewDetail.FullName</td>
                                <td class="text-center">@item.DateFrom.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.DateTo.Value.ToString("dd MMM yyyy")</td>
                                <td class="text-center">@item.Comments</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'CrewTestHistory',
                exportOptions: {
                    columns: [0, 1, 2, 3, 4]
                }
            }
        ]
    });
</script>



