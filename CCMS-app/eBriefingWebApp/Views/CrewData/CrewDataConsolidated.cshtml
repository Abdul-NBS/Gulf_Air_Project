                      </div>
                        <div class="card-body">
                            <table style="width: 100%;">
                                <tbody>
                                    @{

                                    }
                                    <tr>
                                        <td style="width:50%">
                                            <table>
                                                <tr>
                                                    <td class="text-left fw-bold">Staff No :   @(Model.StaffNumber)</td>
                                                </tr>
                                                <tr> <td class="text-left fw-bold">Staff Name :  @(Model.FullName)</td></tr>

                                                <tr>
                                                    <td class="text-left fw-bold">Category :   @(Model.Designation)</td>

                                                </tr>
                                                <tr>
                                                    <td class="text-left fw-bold">Gender :   @(Model.gender)</td>

                                                </tr>
                                                <tr>
                                                    <td class="text-left fw-bold">Nationality :   @(Model.nation)</td>

                                                </tr>
                                               
                                            </table>
                                        </td>
                                        

                                       
                                        <td class="text-right fw-bold" style="width:50%">
