@model eBriefingWebApp.Models.CrewDataPojo
@{
    ViewBag.Title = "Crew Consolidated Data";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("CrewDataConsolidated", "CrewData", FormMethod.Get))
{
    <div class="row">
        <div class="col-12 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Crew Detail</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <div class="input-group mb-3 justify-content-end">

                            @Html.TextBoxFor(u => Model.StaffNumber, new { @id = "StaffNumber", @type = "numric", @class = "form-control", @placeholder = "Staff Number", @required = "required" })
                            <input id="btnGetCrew" class="btn btn-dark btn-sm" type="button" value="Get Crew Detail" />
                        </div>
                    </div>

                    <div id="divStaffName" class="form-group">
                        <label class="fw-bold">Full Name</label>
                        <br />
                        <label id="lblStaffName"></label>

                    </div>

                    <div id="divCategory" class="form-group">
                        <label class="fw-bold">Category</label>
                        <br />
                        <label id="lblCategory"></label>

                    </div>



                </div>
                <div class="card-footer">
                    <button id="btnSubmit" class="btn btn-dark" type="submit" disabled>View Crew Data</button>

                </div>
            </div>
        </div>


    </div>



    <script src="~/Content/js/jquery-3.6.0.js"></script>
    <script>
        $(document).ready(function () {
            $("#divStaffName").hide();
            $("#divCategory").hide();
        });

        $("#btnGetCrew").click(function () {
            var staffNumber = $("#StaffNumber").val();

            if (staffNumber != "") {
                GetReocrd(staffNumber);
            }
            else {
                alert("Missing Staff Number");
            }
        });

        function GetReocrd(staffNumber) {
            $.ajax({
                url: "/CrewData/GetStaffInfo",
                type: "Get",
                data: { StaffNumber: staffNumber },
                success: function (data) {
                    $("#divStaffName").show();
                    $("#divCategory").show();

                    $("#lblStaffName").text(data.FullName);
                    $("#lblCategory").text(data.Category);
                    $("#Category").val(data.Category);

                    $("#btnSubmit").prop('disabled', false);
                },
                error: function (msg) {
                    $("#divStaffName").hide();
                    $("#divCategory").hide();
                    $("#lblStaffName").text("");
                    $("#lblCategory").text("");
                    $("#btnSubmit").prop('disabled', true);
                    alert("Crew Details Not Found.");
                }
            });
        }
    </script>
}
