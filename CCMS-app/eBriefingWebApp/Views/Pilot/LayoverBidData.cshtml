@{
    eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();
    var maximum_bids = db.Maximum_Bids.ToList();
}
@if (maximum_bids.Count > 0)
{

    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header bg-primary">
                    <h5 class="card-title mb-0 text-white">Maximum Bids</h5>
                </div>
                <table id="TableData" class="table table-borderless my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Type</th>
                            <th class="text-center fw-bold">Flight Crew Boeing</th>
                            <th class="text-center fw-bold">Flight Crew Airbus</th>
                            <th class="text-center fw-bold">Cabin Mangers</th>
                            <th class="text-center fw-bold">Cabin Senior</th>
                            <th class="text-center fw-bold">FG/FA</th>

                        </tr>
                    </thead>
                    <tbody>


                        @foreach (var bid in maximum_bids)
                        {

                            <tr>
                                <td class="text-center">@(bid.BID_TYPE)</td>

                                <td class="text-center">@(bid.FC_BOING_MAX)</td>
                                <td class="text-center">@(bid.FC_AIRBUS_MAX)</td>
                                <td class="text-center">@(bid.CM_MAX)</td>
                                <td class="text-center">@(bid.CS_MAX)</td>
                                <td class="text-center">@(bid.FG_FA_MAX)</td>


                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>





}



