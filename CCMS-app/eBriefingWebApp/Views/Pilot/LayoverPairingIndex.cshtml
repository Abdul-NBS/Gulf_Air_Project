@model List<eBriefingWebApp.Layover_Pairing>
@{
    ViewBag.Title = "Layover Pairing Categories";
    Layout = "~/Views/Shared/_layout.cshtml";
}


@if (Model != null)

{
    @*<input type="hidden" id="currentPage" value="" />*@

    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />


    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header bg-primary">
                    <h5 class="card-title mb-0 text-white">Boeing Fleet Pairings</h5>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Pairing Name</th>

                            <th class="text-center fw-bold">Category</th>
                            <th class="text-center fw-bold">Seperation days</th>
                            <th class="text-center fw-bold">Flight Separation Days Calculator</th>


                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int currentPage = Convert.ToInt32(Request.Form["currentPage"]);
                        }

                        @for (int j = 0; j < Model.Count; j++)
                        {
                            if (Model[j].Fleet_Id == 1)
                            {
                                var seperationdays = 0;
                                var categoryId = Model[j].Pairing_Category.ID;
                                if (categoryId == 1)
                                {
                                    seperationdays = 90;
                                }
                                else if (categoryId == 2)
                                {
                                    seperationdays = 90;
                                }
                                else if (categoryId == 3)
                                {
                                    seperationdays = 60;
                                }
                                <tr>
                                    <td class="text-center">@(Model[j].Pairing)</td>

                                    <td class="text-center">@(Model[j].Pairing_Category.CategoryName)</td>
                                    <td class="text-center">@seperationdays</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("FltSepDaysCalculator", "Home", new { Id = (Model[j].ID) })" title="Flight Separation Days Calculator">
                                         <!--   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>-->
                                       
                                        Calculate
                                        </a>
                                    </td>


                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@if (Model != null)
{
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header bg-primary">
                    <h5 class="card-title mb-0 text-white">Airbus Fleet Pairings</h5>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Pairing Name</th>

                            <th class="text-center fw-bold">Category</th>
                            <th class="text-center fw-bold">Seperation Days</th>
                            <th class="text-center fw-bold">Flight Separation Days Calculator</th>

                        </tr>
                    </thead>
                    <tbody>


                        @for (int j = 0; j < Model.Count; j++)
                        {
                            if (Model[j].Fleet_Id == 2)
                            {
                                var seperationdays = 0;
                                var categoryId = Model[j].Pairing_Category.ID;
                                if (categoryId == 1)
                                {
                                    seperationdays = 90;
                                }
                                else if (categoryId == 2)
                                {
                                    seperationdays = 90;
                                }
                                else if (categoryId == 3)
                                {
                                    seperationdays = 60;
                                }
                                <tr>
                                    <td class="text-center">@(Model[j].Pairing)</td>

                                    <td class="text-center">@(Model[j].Pairing_Category.CategoryName)</td>

                                    <td class="text-center">@seperationdays</td>
                                    <td class="text-center">
                                        <a href="@Url.Action("FltSepDaysCalculator", "Pilot", new { Id = (Model[j].ID) })" title="Flight Separation Days Calculator">
                                            <!--<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>-->
                                         Calculate
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}



