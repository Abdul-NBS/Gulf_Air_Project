@model List<eBriefingWebApp.CrewLeaveRequest>
@{
    ViewBag.Title = "CREW LEAVE REQUESTS TO BE REVIEWED";
    Layout = "~/Views/Shared/_layout.cshtml";
}

@using (Html.BeginForm("CrewLeaveRequests", "CrewLeave", FormMethod.Post))
{
    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />

    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">

                    <br />
                    @{
                        eBriefingWebApp.CSMEntities db = new eBriefingWebApp.CSMEntities();
                        var rosterdata = db.CrewLeaveRosterPeriods.Where(a => a.IsActive == true).FirstOrDefault();
                        var rosterFrom = rosterdata.FROM_DATE;
                        var rosterTo = rosterdata.TO_DATE;
                        var announcementtext = "";
                        var announcment = db.CrewLeaveAnnouncements.Where(a => a.IsActive == true).FirstOrDefault();
                        if (announcment != null)
                        {
                            announcementtext = announcment.Announcement;
                                        }

                    }
                    <div class="row">

                        <div class="row" style="padding: 10px; border-radius: 5px;">
                            <div class="col-md-12">
                                <h6 class="card-title mb-0" style="font-size: 0.925em; font-family:verdana; font-style: italic;">
                                    Management Announcement :
                                    <span class="text-danger" style="font-size: 0.925em; font-weight: normal;">@(announcementtext)</span>
                                </h6>
                            </div>
                        </div>

                    </div>
                    <br/>
                    <div class="row">

                        <div class="col-md-8">
                            <h5 class="card-title mb-0 text-success">Current Open Period for Published Leave Requests -  @(rosterFrom.Value.ToString("dd MMM")) to @(rosterTo.Value.ToString("dd MMM"))</h5>
                        </div>

                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">#</th>
                            <th class="text-center fw-bold">Staff Number</th>
                            <th class="text-center fw-bold">Staff Name</th>
                            <th class="text-center fw-bold">From Date</th>
                            <th class="text-center fw-bold">To Date</th>
                            <th class="text-center fw-bold">Leave Comments</th>
                            <th class="text-center fw-bold">Submitted Time</th>
                            <th class="text-center fw-bold">Status</th>
                            <th class="text-center fw-bold">Admin Comments</th>
                            <th class="text-center fw-bold">Updated By</th>
                            <th class="text-center fw-bold">Review</th>
                            <th class="text-center fw-bold">Approve</th>
                            <th class="text-center fw-bold">Reject</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            for (int j = 0; j < Model.Count; j++)
                            {

                                var staffNumber = Model[j].StaffNumber;
                                var stffinfo = db.PilotCrewDetails.Where(a => a.StaffNumber == staffNumber).FirstOrDefault();
                                String stfName = "";
                                if (stffinfo != null)
                                {
                                    stfName = stffinfo.FullName;
                                }


                                                <tr>
                                                    <td class="text-center">@i</td>
                                                    <td class="text-center">@(Model[j].StaffNumber)</td>
                                                    <td class="text-center">@(stfName)</td>
                                                    <td class="text-center">@(Model[j].FROM_DATE.Value.ToString("dd MMM"))</td>
                                                    <td class="text-center">@(Model[j].TO_DATE.Value.ToString("dd MMM"))</td>
                                                    <td class="text-left">@(Model[j].LEAVE_REASON)</td>
                                                    <td class="text-center">@(Model[j].SUBMITTED_TIME.Value.ToString("dd MMM hh:mm tt"))</td>
                                                    @{
                                                        var statusStr = "";
                                                        var status = Model[j].STATUS;
                                                        if (status == "S")
                                                        {
                                                            statusStr = "Submitted";
                                                        }
                                                        else if (status == "A")
                                                        {
                                                            statusStr = "Approved";
                                                        }
                                                        else if (status == "R")
                                                        {
                                                            statusStr = "Rejected";
                                                        }
                                                        else if (status == "P")
                                                        {
                                                            statusStr = "To be Reviewed";
                                                        }
                                                    }
                                                    <td class="text-center">@(statusStr)</td>
                                                    <td class="text-left">@(Model[j].ADMIN_REASON)</td>
                                                    <td class="text-center">@(Model[j].Updated_By)</td>
                                                    <td class="text-center">
                                                        <a href="#" class="reviewLink" data-id="@(Model[j].Id)" title="Mark for Review">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="orange" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                        </a>
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="#" class="approveLink" data-id="@(Model[j].Id)" title="Approve Leave">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="green" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check-circle"><path d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2s10 4.477 10 10zm-3-3.46l-5.17 6.01-2.51-2.91a1 1 0 0 1 1.42-1.42l2.09 2.43 4.59-5.32a1 1 0 0 1 1.42 1.42z"></path></svg>
                                                        </a>
                                                    </td>
                                                    <td class="text-center">
                                                        <a href="#" class="rejectLink" data-id="@(Model[j].Id)" title="Reject Leave">
                                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x-circle"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                                        </a>
                                                    </td>
                                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="commentModal" tabindex="-1" aria-labelledby="commentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentModalLabel">Enter Comments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <textarea id="adminComments" class="form-control" rows="3"></textarea>
                <input type="hidden" id="leaveRequestId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="saveComment">Save changes</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        let clickedButtonType = ""; // Store the button type

        $('.approveLink, .rejectLink, .reviewLink').click(function (e) {
            e.preventDefault();
            var leaveRequestId = $(this).data('id');
            $('#leaveRequestId').val(leaveRequestId);
            if ($(this).hasClass('approveLink')) {
                clickedButtonType = "Approve";
            } else if ($(this).hasClass('rejectLink')) {
                clickedButtonType = "Reject";
            } else if ($(this).hasClass('reviewLink')) {
                clickedButtonType = "Review";
            }
            $('#commentModal').modal('show');
        });

        $('#saveComment').click(function () {
            var leaveRequestId = $('#leaveRequestId').val();
            var adminComments = $('#adminComments').val();
            var action = "";

            if (clickedButtonType === "Approve") {
                action = "ApproveLeave";
            } else if (clickedButtonType === "Reject") {
                action = "RejectLeave";
            } else if (clickedButtonType === "Review") {
                action = "ToBeReviewed";
            }

            $.ajax({
                type: "POST",
                url: "/CrewLeave/" + action,
                data: { Id: leaveRequestId, AdminComments: adminComments },
                success: function (response) {
                    $('#commentModal').modal('hide');
                    location.reload();
                    let message = "";
                    if (action === "ApproveLeave") {
                        message = "Approved";
                    } else if (action === "RejectLeave") {
                        message = "Rejected";
                    } else if (action === "ToBeReviewed") {
                        message = "Marked for Review";
                    }
                    alert("Leave request " + message + " Successfully");
                },
                error: function (error) {
                    alert("Error: " + error.statusText);
                }
            });
        });
    });
</script>