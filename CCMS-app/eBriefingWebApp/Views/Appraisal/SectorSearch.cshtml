@model eBriefingWebApp.Models.SectorAppDataPojo
@{
    ViewBag.Title = "Crew Appraisal Sector Wise Data";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

@using (Html.BeginForm("SectorSearchPost", "Appraisal", FormMethod.Post))

{
    @*<input type="hidden" id="currentPage" value="" />*@

    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />
    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">

                        <div>
                            <div class="input-group mb-3">
                                <span style="font-weight:bold">From &nbsp; &nbsp; </span> <input name="From_Block_Date" id="From_Block_Date" value="@Convert.ToDateTime(TempData["From_Block_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                &nbsp;<span style="font-weight:bold"> - &nbsp;  To &nbsp; &nbsp; </span>  <input name="To_Block_Date" id="To_Block_Date" value="@Convert.ToDateTime(TempData["To_Block_Date"]).ToString("yyyy-MM-dd")" class="form-control" type="date" />
                                &nbsp;<span style="font-weight:bold"> - &nbsp; Orgin &nbsp; &nbsp; </span>  @Html.DropDownListFor(model => model.orginSectorId, new SelectList(ViewBag.OriginAirportCode, "ID", "Airport_code"), "Select", new
                                                                                                            {
                                                                                                                @class = "form-control",
                                                                                                                @id = "orginSector",
                                                                                                                @required = "required",
                                                                                                                @style = "width:60px"
                                                                                                            })
                                &nbsp;<span style="font-weight:bold"> - &nbsp;  Destination &nbsp; &nbsp; </span>  @Html.DropDownListFor(model => model.dstnSectorId, new SelectList(ViewBag.DestinationAirportCode, "ID", "Airport_code"), "Select", new
                                                                                                                 {
                                                                                                                     @class = "form-control",
                                                                                                                     @id = "destSector",
                                                                                                                     @required = "required",
                                                                                                                     @style = "width:60px"
                                                                                                                 })             &nbsp;<span style="font-weight:bold"> - &nbsp;  Team Lead &nbsp; &nbsp; </span>  @Html.DropDownListFor(model => model.TLIdCd, new SelectList(ViewBag.TLlist, "ID", "StaffNo"), "Select", new
                                                                                                                    {
                                                                                                                    @class = "form-control",
                                                                                                                    @id = "destSector",
                                                                                                                    @style = "width:120px"
                                                                                                                    })


                            <div class="input-group-append">
                                <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
                <table id="TableData" class="table table-striped table-hover my-0">

                    <thead>
                       <!-- <tr>
                            <th class="text-center fw-bold">Total OAB : @Model.totalOAB </th>
                            <th class="text-center fw-bold">Total Flights :  @Model.totalFlight </th>
                            <th class="text-center fw-bold">Overall OAB % :  @Model.percentOverall</th>
                          
                        </tr>-->
                    
                    
                        <tr  style="height: 10px;">
                            <th class="text-center fw-bold">Block Number</th>
                            <th class="text-center fw-bold">Appraiser Name</th>
                            <th class="text-center fw-bold">Appraisee Name</th>
                            <th class="text-center fw-bold">Total Score %</th>
                            <th class="text-center fw-bold">Appraisal Date</th>
                            <th class="text-center fw-bold">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.crewAppraisalDatas != null)
                        {

                            foreach (var appdata in Model.crewAppraisalDatas)
                            {

                                <tr>
                                    <td class="text-center">@appdata.BlockName</td>
                                    <td class="text-center">@appdata.appraiserName</td>
                                    <td class="text-center">@appdata.crewStaffName</td>
                                    <td class="text-center">@appdata.TotalScore</td>
                                    <td class="text-center">@appdata.submittedDate.Value.ToString("dd MMM yyyy")</td>

                                    <td class="text-center">
                                        <a href="@Url.Action("CrewAppraisalInfoFromSector", "Appraisal", new { Id = appdata.Id , FromDate = TempData["From_Block_Date"] , Todate = TempData["To_Block_Date"],Origin = Model.orginSectorId,Dest = Model.dstnSectorId,Tlid = Model.TLIdCd  })" title="View Appraisal Info">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>

    </div>

    if (TempData["Status"] != null)
    {
        if (TempData["Status"].ToString() == "Error")
        {
            <script>
                toastr.error('Error Loading Data.');
            </script>
        }
    }
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
        $('#TableData').dataTable({
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'excel',
                    title: 'Sector Wise Appraisal Data Sheet',
                    exportOptions: {
                        columns: [0, 1, 2, 3, 4]
                    }
                }
            ]
        });
</script>





