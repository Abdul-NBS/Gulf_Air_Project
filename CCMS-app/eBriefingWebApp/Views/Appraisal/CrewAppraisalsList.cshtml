@model eBriefingWebApp.Models.MonthlyAppraisalData
@{
    ViewBag.Title = "Team Lead Wise Monthly Data Overall";
    Layout = "~/Views/Shared/_layout.cshtml";
}
@using (Html.BeginForm("CrewAppraisalsList", "Appraisal", FormMethod.Post))
{
    @*<input type="hidden" id="currentPage" value="" />*@

    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />
    if (Model != null)
    {
        <div class="row">
            <div class="col-12 d-flex">
                <div class="card flex-fill">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-8">
                                <h5 class="card-title mb-0">@ViewBag.Title</h5>
                            </div>
                            <div class="col-md-4 justify-content-end">
                                <div class="input-group mb-3">
                                    <div class="input-group mb-3">
                                        <input name="Block_Date" id="Block_Date" value="@Convert.ToDateTime(TempData["Block_Date"]).ToString("yyyy-MM")" class="form-control" type="month" />
                                        <div class="input-group-append">
                                            <button class="btn btn-dark btn-outline-secondary" type="submit">Get Data</button>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <table id="TableData" class="table table-striped table-hover my-0">
                        <thead>





                            <tr>
                                <th class="text-center">Staff No</th>
                                <th class="text-center">Appraiser Name</th>
                                <th class="text-center">OBA Count</th>
                                <th class="text-center">Flight Count</th>
                                <th class="text-center">More Details</th>
                            </tr>
                        </thead>
                        <tbody>



                            @if (Model.monthlyLeadAppraisalDatas != null)
                            {





                                for (int i = 0; i < Model.monthlyLeadAppraisalDatas.Count(); i++)
                                {
                                    <tr>
                                        <td class="text-center">@Model.monthlyLeadAppraisalDatas[i].Id</td>
                                        <td class="text-center">@Model.monthlyLeadAppraisalDatas[i].StaffName</td>
                                        <td class="text-center">@Model.monthlyLeadAppraisalDatas[i].count</td>
                                        <td class="text-center">@Model.monthlyLeadAppraisalDatas[i].flightCount</td>

                                        <td class="text-center">
                                            <a href="@Url.Action("ViewLeadData", "Appraisal", new { Id = @Model.monthlyLeadAppraisalDatas[i].Id, Month = (TempData["Block_Date"]) })" title="View Lead Wise Appraisal Data">
                                                <!--<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>-->
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                                            </a>
                                        </td>

                                    </tr>
                                }


                        <tr>

                            <td class="text-center" style="font-weight:bold">Overall Summary</td>
                            <td class="text-center" style="font-weight:bold">
                                Overall % :  @Model.overallAverage   -  Monthly % :@Model.monthlyAverage
                            </td>
                           
                            <td class="text-center" style="font-weight:bold">
                                Total OBA : @Model.OABCount
                            </td>
                            <td class="text-center" style="font-weight:bold">
                                Total Flight : @Model.totalFlight
                            </td>
                            <td></td>




                        </tr>
                     




                            }
                        </tbody>
                        </table>
                </div>
            </div>
        </div>

    }
    else
    {
        <div class="row">
            <div class="col-12 d-flex">
                <div class="card flex-fill">
                    <div class="card-header bg-primary">
                        <h5 class="card-title mb-0 text-white">Appraisal Info</h5>
                    </div>
                    <table class="table table-borderless my-0">
                        <tbody>

                            <tr>
                                <th class="text-center">
                                    No data present
                                </th>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>

<script>
    $(function () {
        var currentPageInput = $('#currentPage');
        var table = $('#TableData').DataTable({
            dom: 'Bfrtip',
            pageLength: 25,

            buttons: [
                {
                    extend: 'excel',
                    title: 'Team Lead Wise Monthly Data Overall',
                    exportOptions: {
                        columns: [0, 1, 2, 3]
                    }
                }
            ],
            initComplete: function () {
                var api = this.api();
                currentPageInput.val(api.page.info().page + 1);
            }
        });

    });
</script>

