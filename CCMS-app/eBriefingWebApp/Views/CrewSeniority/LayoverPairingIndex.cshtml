@model List<eBriefingWebApp.Layover_Pairing>
@{
    ViewBag.Title = "Layover Pairing Categories";
    Layout = "~/Views/Shared/_layout.cshtml";
}


@using (Html.BeginForm("Index", "CrewSeniority", FormMethod.Post))

{
    @*<input type="hidden" id="currentPage" value="" />*@

    <input type="hidden" id="currentPage" name="currentPage" value="@ViewBag.currentPage" />


    <div class="row">
        <div class="col-md-12">
            <div class="card flex-fill">
                <div class="card-header">
                    <div class="row">
                        <div class="col-md-8">
                            <h5 class="card-title mb-0">@ViewBag.Title</h5>
                        </div>

                    </div>
                </div>
                <table>
                    <tr><td> <a href="@Url.Action("AddNewPairingData", "CrewSeniority")" class="btn btn-dark btn-outline-secondary">Add New</a></td></tr>
                </table>
                <table id="TableData" class="table table-striped table-hover my-0">
                    <thead>
                        <tr>
                            <th class="text-center fw-bold">Pairing Name</th>
                            <th class="text-center fw-bold">Fleet</th>
                            <th class="text-center fw-bold">Category</th>
                            <th class="text-center fw-bold">Seperation Days</th>
                          
                            <th class="text-center fw-bold">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int currentPage = Convert.ToInt32(Request.Form["currentPage"]);
                        }

                        @for (int j = 0; j < Model.Count; j++)
                        {
                            var seperationdays = 0;
                            var categoryId = Model[j].Pairing_Category.ID;
                            if (categoryId == 1)
                            {
                                seperationdays = 90;
                            }
                            else if (categoryId == 2)
                            {
                                seperationdays = 90;
                            }
                            else if (categoryId == 3)
                            {
                                seperationdays = 60;
                            }
                            else if (categoryId == 4)
                                    {
                                        seperationdays = 60;
                                    }
                            <tr>
                                <td class="text-center">@(Model[j].Pairing)</td>
                                <td class="text-center">@(Model[j].Fleet_Category.Fleet)</td>
                                <td class="text-center">@(Model[j].Pairing_Category.CategoryName)</td>
                                <td class="text-center">@(seperationdays)</td>
                           

                                <td class="text-center">
                                    <a href="@Url.Action("EditPairingData", "CrewSeniority", new { Id = (Model[j].ID) })" title="Edit Layover Pairing Data">
                                        <!--<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-list align-middle me-2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>-->
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"  
                                             class="feather feather-edit">
                                            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("DeletePairingData", "CrewSeniority", new { Id = (Model[j].ID) })" title="Delete Layover Pairing data">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x align-middle me-2">
                                            <line x1="18" y1="6" x2="6" y2="18"></line>
                                            <line x1="6" y1="6" x2="18" y2="18"></line>
                                        </svg>

                                    </a>
                                  </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
}


<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script src="~/Content/js/popperjs_core2.10.2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.7.2/dist/js/bootstrap.min.js"></script>

<script>
    $(function () {
        var currentPageInput = $('#currentPage');
        var table = $('#TableData').DataTable({
            dom: 'Bfrtip',
            order: [[2, 'desc'], [3, 'asc']],
            columnDefs: [
                {
                    type: 'time-date-sort',
                    targets: [3],
                }
            ],
            buttons: [
                {
                    extend: 'excel',
                    title: 'Layover Pairing Categories',
                    exportOptions: {
                        columns: [0, 1, 2, 3]
                    }
                }
            ],
            initComplete: function () {
                var api = this.api();
                currentPageInput.val(api.page.info().page + 1);
            }
        });

    });
</script>
