@model List<eBriefingWebApp.OCB_Notification>
@{
    ViewBag.Title = "Manage Notification";
    Layout = "~/Views/Shared/_layout.cshtml";
}

<link href="~/Content/plugins/toastr/toastr.css" rel="stylesheet" />
<script src="~/Content/plugins/toastr/toastr.min.js"></script>

<div class="row">
    <div class="col-md-12">
        <div class="card flex-fill">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="card-title mb-0" style="color:black;">@ViewBag.Title</h5>
                    </div>
                    <div class="col-md-4 justify-content-end" style="text-align:end;">
                        <div class="input-group mb-3 justify-content-end" style="text-align:end;">
                            <a href="@Url.Action("AddNewNotification", "eBriefing")" class="btn btn-dark btn-sm" type="submit">Add New</a>
                        </div>
                    </div>
                </div>
            </div>
            <table id="TableData" class="table table-striped table-hover my-0">
                <thead>
                    <tr>
                        <th class="text-center fw-bold">Block Number</th>
                        <th class="text-center fw-bold">Block Date</th>
                        <th class="text-center fw-bold">Flight Number</th>
                        <th class="text-center fw-bold">Flight Date</th>
                        <th class="text-center fw-bold">Comment</th>
                        <th class="text-center fw-bold">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">@item.OCB_Flights.OCB_Blocks.Block_No</td>
                            <td class="text-center">@item.OCB_Flights.OCB_Blocks.Block_Date.Value.ToString("dd MMM yyyy")</td>
                            <td class="text-center">@item.OCB_Flights.Flt_No</td>
                            <td class="text-center">@item.OCB_Flights.Flight_Date.Value.ToString("dd MMM yyyy")</td>
                            <td class="text-center">@item.Comments</td>
                            <td class="text-center">
                                <a href="@Url.Action("EditNotification", "eBriefing", new { Id = item.Id})" title="Edit Notification">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                </a>
                                <a href="@Url.Action("DeleteNotification", "eBriefing", new { Id = item.Id})" title="Delete Notification">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash-2 align-middle me-2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@if (TempData["Status"] != null)
{

    if (TempData["Status"].ToString() == "Added")
    {
        <script>
            toastr.success('Record Added.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Updated")
    {
        <script>
            toastr.success('Record Saved.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Deleted")
    {
        <script>
            toastr.success('Record Deleted.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Exist")
    {
        <script>
            toastr.warning('Record Exist.');
        </script>
    }
    else if (TempData["Status"].ToString() == "Error")
    {
        <script>
            toastr.error('Error Saving Record.');
        </script>
    }
}

<script src="~/Content/plugins/datatables/jquery.dataTables.js"></script>
<script src="~/Content/plugins/datatables/dataTables.bootstrap4.js"></script>
<link href="~/Content/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />
<script src="~/Content/plugins/datatables/extensions/TableTools/js/dataTables.buttons.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.html5.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/pdfmake.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/buttons.flash.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/jszip.min.js"></script>
<script src="~/Content/plugins/datatables/extensions/TableTools/js/vfs_fonts.js"></script>
<link href="~/Content/plugins/datatables/extensions/TableTools/css/buttons.dataTables.min.css" rel="stylesheet" />
<script>
    $('#TableData').dataTable({
        dom: 'Bfrtip',
        buttons: [
            {
                extend: 'excel',
                title: 'CabinCrewPosition',
                exportOptions: {
                    columns: [0, 1, 2, 3]
                }
            }
        ]
    });
</script>

